<?xml version="1.0" encoding="utf-8"?>
<!-- Telnet OLT di LAN memakai cleartext. SSH tetap terenkripsi. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
