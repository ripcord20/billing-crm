<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/bg" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="0"
                android:centerY="0"
                android:endColor="#00000000"
                android:gradientRadius="320dp"
                android:startColor="#33FF4ECD"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="1"
                android:centerY="0"
                android:endColor="#00000000"
                android:gradientRadius="280dp"
                android:startColor="#3322D3EE"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
