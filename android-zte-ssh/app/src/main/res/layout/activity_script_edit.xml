<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scriptEditRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/btnEditBack"
            style="@style/Widget.ZteSsh.Btn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_cyan_outline"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/privacy_back"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/scriptEditTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="@string/script_edit_title"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/scriptName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_script_name"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/scriptNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="@string/hint_script_note"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="72dp"
                android:padding="12dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:text="@string/hint_script_body_label"
                android:textColor="@color/accent"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/scriptBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:hint="@string/hint_script_body"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions|textVisiblePassword"
                android:minHeight="220dp"
                android:padding="12dp"
                android:textColor="@color/term_fg"
                android:textColorHint="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnScriptDelete"
            style="@style/Widget.ZteSsh.Btn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_ghost"
            android:text="@string/script_delete"
            android:textColor="@color/danger" />

        <Button
            android:id="@+id/btnScriptSave"
            style="@style/Widget.ZteSsh.Btn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_cyan"
            android:text="@string/script_save"
            android:textColor="@color/on_accent" />
    </LinearLayout>
</LinearLayout>
