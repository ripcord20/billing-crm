<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.16"
            android:text="@string/tagline"
            android:textColor="@color/accent"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <View
            android:layout_width="56dp"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_accent_bar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="@string/subtitle"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="@string/saved_profiles"
            android:textAllCaps="true"
            android:textColor="@color/accent"
            android:textSize="11sp" />

        <ListView
            android:id="@+id/profileList"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_panel"
            android:cacheColorHint="#00000000"
            android:divider="@color/stroke"
            android:dividerHeight="1dp"
            android:padding="4dp" />

        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/empty"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_name"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/host"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_host"
            android:inputType="textUri"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/port"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_port"
                android:inputType="number"
                android:padding="12dp"
                android:text="22"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/proto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_weight="2"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/protoSsh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent"
                    android:checked="true"
                    android:text="@string/proto_ssh"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/protoTelnet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent"
                    android:text="@string/proto_telnet"
                    android:textColor="@color/text" />
            </RadioGroup>
        </LinearLayout>

        <EditText
            android:id="@+id/user"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_user"
            android:inputType="textVisiblePassword"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_pass"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/enable"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_enable"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSave"
                style="@style/Widget.ZteSsh.Btn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_ghost"
                android:text="@string/save"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/btnConnect"
                style="@style/Widget.ZteSsh.Btn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_cyan"
                android:text="@string/connect"
                android:textColor="@color/on_accent" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDelete"
            style="@style/Widget.ZteSsh.Btn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_ghost"
            android:text="@string/delete_profile"
            android:textColor="@color/danger" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_howto"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:paddingStart="16dp"
            android:text="@string/howto"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/privacyLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/privacy_link"
            android:textColor="@color/accent"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
