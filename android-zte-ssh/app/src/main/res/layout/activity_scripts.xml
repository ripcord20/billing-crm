<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scriptsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/btnScriptsBack"
            style="@style/Widget.ZteSsh.Btn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_cyan_outline"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/privacy_back"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="@string/scripts_title"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/scriptsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/scripts_hint_edit"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/scriptList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_panel"
        android:cacheColorHint="#00000000"
        android:divider="@color/stroke"
        android:dividerHeight="1dp"
        android:padding="4dp" />

    <TextView
        android:id="@+id/scriptsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/scripts_empty"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnScriptNew"
            style="@style/Widget.ZteSsh.Btn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_cyan"
            android:text="@string/script_new"
            android:textColor="@color/on_accent" />

        <Button
            android:id="@+id/btnScriptExamples"
            style="@style/Widget.ZteSsh.Btn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_ghost"
            android:text="@string/script_examples"
            android:textColor="@color/text" />
    </LinearLayout>
</LinearLayout>
