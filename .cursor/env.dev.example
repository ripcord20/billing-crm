# Development environment defaults for Cloud Agent.
# Copied to ./.env by .cursor/install.sh when no .env exists.
# NOTE: dev-only placeholder secrets — do NOT reuse in production.

# ── Application ─────────────────────────────
APP_NAME=FLAYNET.COM
APP_ENV=development
NODE_ENV=development
APP_PORT=3003
APP_URL=http://localhost:3003
BASE_URL=http://localhost:3003
APP_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta

# ── Database (local MariaDB) ────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=isp_netops
DB_USER=ispuser
DB_PASS=isppass

# ── JWT / Auth secrets (dev only) ───────────
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
JWT_EXPIRY=30d
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
JWT_REFRESH_EXPIRY=7d
JWT_PORTAL_SECRET=dev-portal-secret-change-me-0123456789abcdef
JWT_RESELLER_SECRET=dev-reseller-secret-change-me-0123456789abcdef

# ── Config encryption (stored device creds) ─
CONFIG_ENCRYPTION_KEY=dev-config-encryption-key-32bytes-minimum-0123456789

# ── Logging ─────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

# ── Company info (display only) ─────────────
COMPANY_NAME=FLAYNET
COMPANY_EMAIL=info@flaynet.local
COMPANY_PHONE=+620000000000
COMPANY_WEBSITE=http://localhost:3003

# ── Seed admin bootstrap (npm run seed) ─────
SEED_ADMIN_EMAIL=admin@flaynet.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Super Admin
SEED_DEMO_PASS=demo12345
