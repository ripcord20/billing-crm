<script>
(function(){ try { var t = localStorage.getItem('ui-theme'); if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t); } catch (e) {} })();
</script>
<!-- White-label theme override (dari Settings > Tema Warna) -->
<% if (locals.themePrimary) { %>
<%
  const _p = locals.themePrimary;
  const _a = locals.themeAccent || locals.themePrimary;
%>
<style id="wl-theme">
  :root {
    --primary: <%= _p %> !important;
    --primary-dark: <%= _p %> !important;
    --primary-light: <%= _a %> !important;
    --accent: <%= _a %> !important;
    --d-blue1: <%= _p %> !important; --d-blue2: <%= _p %> !important; --d-blue3: <%= _a %> !important;
    --s-blue: <%= _p %> !important; --s-blue-d: <%= _p %> !important; --s-blue3: <%= _a %> !important;
    --wl-p: <%= _p %>; --wl-a: <%= _a %>;
  }
  /* Override warna brand hardcoded (#1a6ef5 dsb) di sidebar & komponen umum */
  .nav-sub:hover, .nav-sub.active { color: var(--wl-p) !important; }
  .nav-sub.active .nav-sub-dot { background: var(--wl-p) !important; }
  .nav-item.active, .nav-item.active .nav-icon { color: var(--wl-p) !important; }
  .nav-item.active { background: rgba(0,0,0,.04) !important; }
  .profile-avatar { background: linear-gradient(135deg, var(--wl-p), var(--wl-a)) !important; box-shadow: 0 0 0 2.5px var(--wl-p), 0 3px 10px rgba(0,0,0,.25) !important; }
  .btn-primary, .btn-blue { background: var(--wl-p) !important; }
  .btn-primary:hover, .btn-blue:hover { background: var(--wl-a) !important; }
  /* Elemen umum yang sering pakai brand color */
  a:not(.btn):not(.nav-item):not(.st-nav-item) { color: var(--wl-p); }
</style>
<% } %>
<!-- Sidebar -->
<aside id="sidebar" class="sidebar">
<% const isDemoUser    = user && user.role && (user.role.name === 'demo'); %>
<% const isFinanceUser = user && user.role && (user.role.name === 'finance'); %>
<% const isNocUser     = user && user.role && (user.role.name === 'noc'); %>
<% const isSalesUser   = user && user.role && (user.role.name === 'sales'); %>
<% const isTenantOwner = user && user.role && (user.role.name === 'tenant_owner'); %>
<%
  const canMod = (typeof locals.canModule === 'function')
    ? locals.canModule
    : function (key) {
        const r = ((user && user.role && user.role.name) || '').toLowerCase();
        if (r === 'superadmin') return true;
        const perms = (user && user.role && user.role.permissions) || [];
        return perms.some(function (p) { return p && p.name === ('module.' + key); });
      };
  function anyMod(keys) { return keys.some(canMod); }
%>
<% function demoHide(flag) { return flag ? 'style="display:none;"' : ''; } %>
<% function financeHide(flag) { return flag ? 'style="display:none;"' : ''; } %>
  <div class="sidebar-header">
    <div class="sidebar-logo" id="sidebarBrand">
      <%
        // Ambil brand settings dari app (fallback ke default)
        const brandMode   = locals.brandMode   || locals.appSettings?.brand_mode   || 'name_tagline';
        const appName     = locals.appName     || locals.appSettings?.app_name     || 'DIGSnet';
        const appTagline  = locals.appTagline  || locals.appSettings?.app_tagline  || 'ISP Management';
        const logoUrl     = locals.logoUrl     || locals.appSettings?.logo_url     || '';
      %>
      <% if (brandMode === 'logo_only' && logoUrl) { %>
        <img src="<%= logoUrl %>" alt="<%= appName %>" style="height:36px;object-fit:contain;">
      <% } else if (brandMode === 'name_logo' && logoUrl) { %>
        <img src="<%= logoUrl %>" alt="logo" style="height:32px;object-fit:contain;flex-shrink:0;">
        <span class="logo-text"><%= appName %></span>
      <% } else { %>
        <div class="logo-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
          </svg>
        </div>
        <div style="display:flex;flex-direction:column;line-height:1.2;">
          <span class="logo-text" style="font-size:15px;font-weight:800;"><%= appName %></span>
          <% if (brandMode === 'name_tagline' && appTagline) { %>
          <span style="font-size:9.5px;color:#94a3b8;font-weight:500;letter-spacing:.03em;"><%= appTagline %></span>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>

  <nav class="sidebar-nav">

  <%- include('sidebar-nav') %>


  </nav>

  <!-- Profile footer -->
  <div class="sidebar-footer">
    <div class="sidebar-profile">
      <div class="profile-avatar-wrap">
        <div class="profile-avatar" id="sidebarAvatar" data-avatar="<%= (user && user.avatar) ? user.avatar : '' %>">
          <% if (user && user.avatar) { %>
            <img src="<%= user.avatar %>" alt="Avatar" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
          <% } else { %>
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <% } %>
        </div>
      </div>
      <div class="profile-info">
        <div class="profile-name" id="sidebarName"><%= user?.name || user?.username || 'Admin' %></div>
        <div class="profile-role" id="sidebarRole"><%=
          (user?.role && typeof user.role === 'object' ? (user.role.name || user.role.label || '') : '') ||
          (typeof user?.role === 'string' ? user.role : '') ||
          'Administrator'
        %></div>
      </div>
      <a href="#" id="logoutBtnProfile" title="Logout" class="profile-logout-btn">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16,17 21,12 16,7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      </a>
    </div>
  </div>

<% if (isDemoUser) { %>
<script>
  // Auto-hide menu tidak relevan untuk user demo
  (function() {
    const hideSelectors = [
      'a[href="/broadcast"]',
      'a[href="/wa/reminder"]',
      'a[href="/wa/report"]',
      'a[href="/isolir"]',
      'a[href="/settings"]',
      'a[href="/settings/users"]',
      'a[href="/system/topology"]',
      'a[href="/whatsapp"]',
    ];
    document.addEventListener('DOMContentLoaded', () => {
      hideSelectors.forEach(sel => {
        document.querySelectorAll(sel).forEach(el => el.style.display = 'none');
      });
    });
  })();
</script>
<% } %>

</aside>

<style>
.sidebar-footer{padding:0;border-top:1px solid #f0f4ff;background:#fff;}
.sidebar-profile{display:flex;align-items:center;gap:10px;padding:12px 14px;background:#fff;}
.profile-avatar-wrap{position:relative;flex-shrink:0;}
.profile-avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#1a6ef5,#0047cc);display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;font-weight:800;letter-spacing:-.5px;border:2.5px solid rgba(255,255,255,.15);box-shadow:0 0 0 2.5px #1a6ef5,0 3px 10px rgba(26,110,245,.45);transition:box-shadow .2s;}
.profile-avatar:hover{box-shadow:0 0 0 2.5px #1a6ef5,0 4px 16px rgba(26,110,245,.6);}
.profile-avatar-wrap::after{content:'';position:absolute;bottom:1px;right:1px;width:9px;height:9px;border-radius:50%;background:#22c55e;border:2px solid #fff;}
.profile-info{flex:1;min-width:0;}
.profile-name{font-size:12.5px;font-weight:700;color:#0d1b3e;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3;}
.profile-role{font-size:10.5px;color:#94a3b8;text-transform:capitalize;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.profile-logout-btn{margin-left:auto;width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:8px;color:#94a3b8;transition:all .15s;flex-shrink:0;text-decoration:none;}
.profile-logout-btn:hover{background:rgba(245,54,92,.12);color:#f5365c;}

/* ── Nav dropdown group ── */
.nav-group{margin:0;}
.nav-group-toggle{
  width:100%;background:transparent;border:none;text-align:left;
  font-family:inherit;cursor:pointer;
  display:flex;align-items:center;
}
.nav-group-toggle .nav-chev{
  width:14px;height:14px;margin-left:auto;flex-shrink:0;
  transition:transform .2s ease;color:currentColor;opacity:.55;
}
.nav-group.open .nav-group-toggle .nav-chev{transform:rotate(180deg);opacity:.85;}
.nav-group-children{
  max-height:0;overflow:hidden;
  transition:max-height .25s ease;
}
.nav-group.open .nav-group-children{max-height:240px;}
.nav-sub{
  display:flex;align-items:center;gap:10px;
  padding:8px 18px 8px 44px;
  font-size:12.5px;font-weight:500;color:#64748b;
  text-decoration:none;border-radius:0;
  position:relative;transition:background .15s,color .15s;
}
.nav-sub:hover{color:#1a6ef5;background:rgba(26,110,245,.05);}
.nav-sub.active{color:#1a6ef5;font-weight:700;background:rgba(26,110,245,.08);}
.nav-sub.active .nav-sub-dot{background:#1a6ef5;transform:scale(1.4);}
.nav-sub-dot{
  width:5px;height:5px;border-radius:50%;background:#cbd5e1;
  flex-shrink:0;transition:background .15s,transform .15s;
}
</style>

<script>
(function(){
  const nameEl = document.getElementById('sidebarName');
  const av = document.getElementById('sidebarAvatar');
  if(nameEl && av){
    const hasAvatar = av.getAttribute('data-avatar') || av.querySelector('img');
    if(!hasAvatar){
      const name = nameEl.textContent.trim();
      const initials = name.split(/\s+/).filter(Boolean).map(w=>w[0]).slice(0,2).join('').toUpperCase() || 'A';
      av.textContent = initials;
    }
  }
  // GenieACS online badge
  (async () => {
    try {
      const r = await fetch('/api/genieacs/stats');
      const j = await r.json();
      if (j.success && j.data?.online > 0) {
        const badge = document.getElementById('genieacs-online-badge');
        if (badge) { badge.textContent = j.data.online; badge.style.display = 'inline-flex'; }
      }
    } catch(e) {}
  })();

  const logoutBtn = document.getElementById('logoutBtnProfile') || document.getElementById('logoutBtn');
  if(logoutBtn){
    logoutBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      // Defensive logout flow — pastikan SELALU berhasil meski API gagal.
      // PENTING beberapa hal yang sering jadi bug:
      //   1. Clear localStorage DULU — biar state client pasti bersih.
      //   2. fetch HARUS pakai `credentials: 'include'` supaya cookie token
      //      dikirim ke server (kalau tidak, server `authenticate` middleware
      //      return 401 → endpoint logout tidak pernah jalan → cookie tidak
      //      ter-clear → user balik ke dashboard karena auto-redirect di /login).
      //   3. Pakai Bearer header juga sebagai backup auth.
      //   4. Timeout 3 detik supaya tombol tidak gantung kalau server lambat.
      //   5. window.location.replace (bukan href) — tombol Back tidak balik
      //      ke dashboard yang sudah logged-out.
      let bearerToken = null;
      try {
        bearerToken = localStorage.getItem('token');
        localStorage.removeItem('token');
        localStorage.removeItem('refreshToken');
        localStorage.removeItem('user');
      } catch(_) { /* localStorage disabled — ignore */ }

      const ctrl = new AbortController();
      const t = setTimeout(() => ctrl.abort(), 3000);
      try {
        const hdr = { 'X-Requested-With': 'XMLHttpRequest' };
        if (bearerToken && bearerToken !== 'null') hdr['Authorization'] = 'Bearer ' + bearerToken;
        await fetch('/api/auth/logout', {
          method: 'POST',
          credentials: 'include',
          headers: hdr,
          signal: ctrl.signal
        });
      } catch(_) { /* timeout/network — abaikan */ }
      clearTimeout(t);

      window.location.replace('/login');
    });
  }
})();

// Nav dropdown group toggle (Billing & Invoice, etc.)
function toggleNavGroup(btn){
  const group = btn.closest('.nav-group');
  if (group) group.classList.toggle('open');
}
</script>
