<% const _custNavOn = ['customers','customers-stopped'].includes(active); %>
<div class="nav-group <%= _custNavOn ? 'open' : '' %>" data-nav-group="customers">
  <button type="button" class="nav-item nav-group-toggle <%= _custNavOn ? 'active' : '' %>" onclick="toggleNavGroup(this)">
    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    <span><%= typeof navLabel === 'string' ? navLabel : 'Customers' %></span>
    <svg class="nav-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
  </button>
  <div class="nav-group-children">
    <a href="/customers" class="nav-sub <%= active === 'customers' ? 'active' : '' %>">
      <span class="nav-sub-dot"></span>
      <span>Daftar Pelanggan</span>
    </a>
    <a href="/customers/stopped" class="nav-sub <%= active === 'customers-stopped' ? 'active' : '' %>">
      <span class="nav-sub-dot"></span>
      <span>Pelanggan Berhenti</span>
    </a>
  </div>
</div>
