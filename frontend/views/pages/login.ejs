<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Login' %> - <%= appName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Orbitron:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #05060f;
      color: #e8f6ff;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(34, 211, 238, 0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(34, 211, 238, 0.07) 1px, transparent 1px);
      background-size: 46px 46px;
      mask-image: radial-gradient(ellipse at center, #000 20%, transparent 72%);
      pointer-events: none;
    }

    .beam {
      position: fixed;
      pointer-events: none;
      filter: blur(8px);
      opacity: 0.85;
    }
    .beam-a {
      top: -8vh;
      left: 8vw;
      width: 2px;
      height: 70vh;
      background: linear-gradient(180deg, transparent, #22d3ee, transparent);
      transform: rotate(18deg);
      box-shadow: 0 0 18px #22d3ee;
    }
    .beam-b {
      top: 10vh;
      right: 12vw;
      width: 2px;
      height: 80vh;
      background: linear-gradient(180deg, transparent, #ff4ecd, transparent);
      transform: rotate(-14deg);
      box-shadow: 0 0 18px #ff4ecd;
    }
    .beam-c {
      bottom: -10vh;
      left: 28vw;
      width: 40vw;
      height: 2px;
      background: linear-gradient(90deg, transparent, #22d3ee, #ff4ecd, transparent);
      transform: rotate(-8deg);
      opacity: 0.55;
    }

    .terminal {
      position: relative;
      width: min(460px, calc(100% - 28px));
      margin: 28px auto;
      padding: 28px 26px 18px;
      background: rgba(7, 8, 20, 0.88);
      border: 1px solid rgba(34, 211, 238, 0.28);
      box-shadow:
        0 0 0 1px rgba(255, 78, 205, 0.08),
        0 30px 80px rgba(0, 0, 0, 0.55),
        inset 0 0 80px rgba(34, 211, 238, 0.04);
      z-index: 1;
    }

    .corner {
      position: absolute;
      width: 18px;
      height: 18px;
      pointer-events: none;
    }
    .c-tl { top: -2px; left: -2px; border-top: 2px solid #22d3ee; border-left: 2px solid #22d3ee; }
    .c-tr { top: -2px; right: -2px; border-top: 2px solid #ff4ecd; border-right: 2px solid #ff4ecd; }
    .c-bl { bottom: -2px; left: -2px; border-bottom: 2px solid #22d3ee; border-left: 2px solid #22d3ee; }
    .c-br { bottom: -2px; right: -2px; border-bottom: 2px solid #ff4ecd; border-right: 2px solid #ff4ecd; }

    .term-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      letter-spacing: 0.14em;
      color: #67e8f9;
      margin-bottom: 28px;
    }
    .term-top .secure {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .pulse {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #22d3ee;
      box-shadow: 0 0 8px #22d3ee;
    }
    .term-top .node { color: #c4b5fd; }

    .kicker {
      text-align: center;
      font-size: 12px;
      letter-spacing: 0.42em;
      color: #a5f3fc;
      margin-bottom: 8px;
    }

    h1 {
      text-align: center;
      font-family: 'Orbitron', sans-serif;
      font-size: clamp(40px, 11vw, 58px);
      font-weight: 800;
      letter-spacing: 0.16em;
      line-height: 1;
      margin-bottom: 10px;
      background: linear-gradient(90deg, #22d3ee 0%, #818cf8 48%, #ff4ecd 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .sub {
      text-align: center;
      color: #94a3b8;
      font-size: 12px;
      letter-spacing: 0.04em;
      margin-bottom: 26px;
    }

    #tryBanner {
      display: none;
      margin: 0 0 16px;
      padding: 12px 14px;
      border: 1px solid rgba(34, 211, 238, 0.45);
      background: rgba(34, 211, 238, 0.08);
      color: #e0f2fe;
      font-size: 12px;
      line-height: 1.5;
    }
    #tryBanner strong { display: block; margin-bottom: 4px; color: #67e8f9; letter-spacing: 0.08em; }
    #tryDemoFill {
      margin-top: 10px;
      border: 1px solid #22d3ee;
      background: transparent;
      color: #67e8f9;
      font-family: inherit;
      font-weight: 700;
      font-size: 11px;
      letter-spacing: 0.08em;
      padding: 8px 12px;
      cursor: pointer;
    }
    #tryDemoFill:hover { background: rgba(34, 211, 238, 0.12); }

    .error-msg {
      display: none;
      background: rgba(255, 78, 205, 0.12);
      border: 1px solid #ff4ecd;
      color: #ffd0f2;
      padding: 12px 14px;
      margin-bottom: 16px;
      font-size: 13px;
      line-height: 1.45;
    }

    .form-group { margin-bottom: 16px; }

    .form-group label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.16em;
      color: #67e8f9;
      margin-bottom: 8px;
    }

    .input-wrapper { position: relative; }

    .field-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #22d3ee;
      display: flex;
      pointer-events: none;
    }

    .form-input {
      width: 100%;
      padding: 13px 44px;
      background: rgba(4, 8, 18, 0.9);
      border: 1px solid rgba(34, 211, 238, 0.55);
      border-radius: 2px;
      color: #f8fafc;
      font-size: 14px;
      font-family: inherit;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .form-input:focus {
      outline: none;
      border-color: #22d3ee;
      box-shadow: 0 0 0 1px #22d3ee, 0 0 16px rgba(34, 211, 238, 0.25);
    }
    .form-input::placeholder { color: #475569; }

    .password-toggle {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: #67e8f9;
      cursor: pointer;
      padding: 4px;
      display: flex;
      align-items: center;
    }
    .password-toggle:hover { color: #ff4ecd; }

    .form-footer {
      display: flex;
      align-items: center;
      margin: 6px 0 18px;
    }

    .remember-me {
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      font-size: 13px;
      color: #cbd5e1;
    }
    .remember-me input {
      appearance: none;
      width: 15px;
      height: 15px;
      border: 1px solid #22d3ee;
      background: transparent;
      cursor: pointer;
      flex-shrink: 0;
    }
    .remember-me input:checked {
      background:
        linear-gradient(#22d3ee, #22d3ee) center / 8px 8px no-repeat,
        transparent;
    }
    .remember-me label { cursor: pointer; font-weight: 500; }

    .login-btn {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 2px;
      cursor: pointer;
      font-family: 'Orbitron', sans-serif;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.28em;
      color: #05060f;
      background: linear-gradient(90deg, #22d3ee 0%, #818cf8 52%, #ff4ecd 100%);
      box-shadow: 0 0 22px rgba(34, 211, 238, 0.28);
    }
    .login-btn:hover { filter: brightness(1.08); }
    .login-btn:disabled { opacity: 0.7; cursor: wait; }

    .credit {
      margin-top: 18px;
      text-align: center;
      font-size: 11px;
      letter-spacing: 0.22em;
      color: #e2e8f0;
    }

    .term-foot {
      display: flex;
      justify-content: space-between;
      margin-top: 22px;
      padding-top: 12px;
      border-top: 1px solid rgba(51, 65, 85, 0.7);
      font-size: 10px;
      letter-spacing: 0.16em;
      color: #64748b;
    }
    .term-foot .ok { color: #4ade80; }

    @keyframes spin { to { transform: rotate(360deg); } }
    .loading-spinner {
      display: inline-block;
      width: 14px;
      height: 14px;
      border: 2px solid rgba(5, 6, 15, 0.25);
      border-top-color: #05060f;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
      margin-right: 8px;
      vertical-align: -2px;
    }
    @keyframes lspin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>
  <script>
    // Tujuan setelah login berhasil. Prioritas:
    //   1) nextUrl dari server (?next= yang sudah divalidasi), lalu
    //   2) ?next= di URL saat ini (fallback), harus path internal yang aman.
    window.FLYN_NEXT = (function(){
      var fromServer = <%- JSON.stringify(typeof nextUrl !== 'undefined' ? nextUrl : '') %>;
      function safe(v){ return (typeof v==='string' && v.charAt(0)==='/' && v.charAt(1)!=='/') ? v : ''; }
      var chosen = '';
      if (safe(fromServer)) chosen = fromServer;
      if (!chosen) {
        try {
          var q = new URLSearchParams(window.location.search).get('next');
          if (safe(q)) chosen = q;
        } catch(_){}
      }
      // Jangan paksa APK ke /mobile. Tampilan biasa = dashboard web.
      try { localStorage.removeItem('flyn_prefer_mobile'); } catch(_){}
      return chosen;
    })();
    // Gabungkan tujuan server-role dengan FLYN_NEXT (kalau ada, next menang).
    window.flynDest = function(serverRedirect){
      return window.FLYN_NEXT || serverRedirect || '/dashboard';
    };
  </script>
  <div id="loginShade" style="position:fixed;inset:0;background:#05060f;z-index:9999;display:flex;align-items:center;justify-content:center;">
    <div style="display:flex;flex-direction:column;align-items:center;gap:14px;color:#94a3b8;font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.12em;">
      <div style="width:32px;height:32px;border:3px solid rgba(34,211,238,.25);border-top-color:#22d3ee;border-radius:50%;animation:lspin 0.8s linear infinite;"></div>
      <div>MEMULIHKAN SESI</div>
    </div>
  </div>
  <script>
    (async function tryRestoreSession() {
      const shade = document.getElementById('loginShade');
      try {
        const t = localStorage.getItem('token');
        if (!t || t === 'null' || t === 'undefined') {
          shade.remove();
          return;
        }
        const r = await fetch('/api/auth/restore-cookie', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Authorization': 'Bearer ' + t, 'X-Requested-With': 'XMLHttpRequest' }
        });
        if (r.ok) {
          const j = await r.json();
          if (j && j.success && j.redirect) {
            window.location.replace(window.flynDest(j.redirect));
            return;
          }
        }
        localStorage.removeItem('token');
        localStorage.removeItem('refreshToken');
        localStorage.removeItem('user');
      } catch (_) {}
      shade.remove();
    })();
  </script>

  <div class="beam beam-a" aria-hidden="true"></div>
  <div class="beam beam-b" aria-hidden="true"></div>
  <div class="beam beam-c" aria-hidden="true"></div>

  <main class="terminal">
    <span class="corner c-tl" aria-hidden="true"></span>
    <span class="corner c-tr" aria-hidden="true"></span>
    <span class="corner c-bl" aria-hidden="true"></span>
    <span class="corner c-br" aria-hidden="true"></span>

    <div class="term-top">
      <span class="secure"><span class="pulse"></span>NET :: SECURE</span>
      <span class="node">NODE 01</span>
    </div>

    <div class="kicker">TERMINAL AKSES</div>
    <h1>MASUK</h1>
    <p class="sub">// nama atau email</p>

    <div id="tryBanner">
      <strong>COBA BILLING FIBERIX</strong>
      <div>Pakai akun demo untuk melihat dashboard, pelanggan, dan tagihan. Data demo bersifat contoh.</div>
      <button type="button" id="tryDemoFill">ISI AKUN DEMO</button>
    </div>

    <div class="error-msg" id="errorMsg"></div>

    <form id="loginForm">
      <div class="form-group">
        <label for="email">NAMA / E-MAIL</label>
        <div class="input-wrapper">
          <span class="field-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="8" r="3.2"></circle>
              <path d="M5 19c1.5-3.1 3.9-4.6 7-4.6s5.5 1.5 7 4.6"></path>
            </svg>
          </span>
          <input
            type="email"
            class="form-input"
            id="email"
            required
            autocomplete="email"
          >
        </div>
      </div>

      <div class="form-group">
        <label for="password">PASSWORD</label>
        <div class="input-wrapper">
          <span class="field-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="5" y="11" width="14" height="9" rx="1.5"></rect>
              <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
            </svg>
          </span>
          <input
            type="password"
            class="form-input"
            id="password"
            required
            autocomplete="current-password"
          >
          <button type="button" class="password-toggle" id="togglePassword" aria-label="Tampilkan password">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
      </div>

      <div class="form-footer">
        <div class="remember-me">
          <input type="checkbox" id="remember">
          <label for="remember">Ingat saya</label>
        </div>
      </div>

      <button type="submit" class="login-btn" id="loginBtn">MASUK</button>
      <script>
        (function() {
          const quickBtn = document.getElementById('demoQuickStart');
          const sharedBtn = document.getElementById('demoSharedFill');
          const loadingEl = document.getElementById('demoLoadingMsg');
          const errorEl = document.getElementById('demoErrorMsg');
          const emailInput = document.getElementById('email');
          const passInput = document.getElementById('password');

          if (!quickBtn || !sharedBtn) return;

          function showError(msg) {
            errorEl.textContent = msg;
            errorEl.style.display = 'block';
            loadingEl.style.display = 'none';
            quickBtn.disabled = false;
            sharedBtn.disabled = false;
          }

          quickBtn.addEventListener('click', async function() {
            errorEl.style.display = 'none';
            loadingEl.style.display = 'block';
            quickBtn.disabled = true;
            sharedBtn.disabled = true;

            try {
              const res = await fetch('/api/demo/provision', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
              });
              const data = await res.json().catch(() => ({}));

              if (data.code === 'DEMO_MIGRATION_NEEDED') {
                loadingEl.style.display = 'none';
                quickBtn.disabled = false;
                sharedBtn.disabled = false;
                showError(data.message);
                setTimeout(() => {
                  if (emailInput) emailInput.value = 'demo@ispnetops.com';
                  if (passInput) passInput.value = 'demo12345';
                  errorEl.textContent = errorEl.textContent + ' (Kredensial sudah diisi otomatis)';
                }, 1500);
                return;
              }

              if (!res.ok || !data.success) {
                showError(data.message || 'Gagal membuat akun demo. Coba lagi atau pakai akun bersama.');
                return;
              }

              if (data.data && data.data.token) {
                try { localStorage.setItem('token', data.data.token); } catch(_) {}
              }
              window.location.href = window.flynDest(data.data && data.data.redirect);
            } catch (e) {
              showError('Tidak bisa terhubung ke server. Coba lagi.');
            }
          });

          sharedBtn.addEventListener('click', function() {
            if (emailInput) emailInput.value = 'demo@ispnetops.com';
            if (passInput) passInput.value = 'demo12345';
            if (emailInput) emailInput.focus();
          });
        })();
      </script>
    </form>

    <p class="credit">DEVELOPED BY SKYNET</p>

    <div class="term-foot">
      <span class="ok">SYS.OK</span>
      <span>// ACCESS TERMINAL</span>
    </div>
  </main>

  <script>
    document.getElementById('tryDemoFill')?.addEventListener('click', function() {
      const emailInput = document.getElementById('email');
      const passInput = document.getElementById('password');
      if (emailInput) emailInput.value = 'demo@ispnetops.com';
      if (passInput) passInput.value = 'demo12345';
      if (passInput) passInput.focus();
    });
    if (new URLSearchParams(location.search).get('coba')) {
      const banner = document.getElementById('tryBanner');
      if (banner) banner.style.display = 'block';
    }

    document.getElementById('togglePassword').addEventListener('click', function() {
      const passwordInput = document.getElementById('password');
      const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
      passwordInput.setAttribute('type', type);
    });

    document.getElementById('loginForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const btn = document.getElementById('loginBtn');
      const errEl = document.getElementById('errorMsg');

      btn.disabled = true;
      btn.innerHTML = '<span class="loading-spinner"></span>MASUK...';
      errEl.style.display = 'none';

      try {
        const response = await fetch('/api/auth/login', {
          method: 'POST',
          credentials: 'include',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            email: document.getElementById('email').value,
            password: document.getElementById('password').value
          })
        });

        const data = await response.json();

        if (data.success) {
          localStorage.setItem('token', data.data.token);
          localStorage.setItem('refreshToken', data.data.refreshToken);
          localStorage.setItem('user', JSON.stringify(data.data.user));
          window.location.href = window.flynDest(data.data.redirect);
        } else {
          errEl.textContent = data.message || 'Login failed. Please check your credentials.';
          errEl.style.display = 'block';
        }
      } catch (error) {
        console.error('Login error:', error);
        errEl.textContent = 'Connection error. Please try again later.';
        errEl.style.display = 'block';
      } finally {
        btn.disabled = false;
        btn.innerHTML = 'MASUK';
      }
    });
  </script>
</body>
</html>
