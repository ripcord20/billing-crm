<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0;font-family:'DM Sans',system-ui,sans-serif;}
    body{background:linear-gradient(135deg,#0b1220,#132a52);min-height:100vh;color:#0f172a;padding:24px;}
    .wrap{max-width:560px;margin:0 auto;}
    .brand{text-align:center;color:#fff;margin:18px 0 22px;}
    .brand h1{font-size:24px;font-weight:800;}
    .brand p{opacity:.75;font-size:14px;margin-top:4px;}
    .card{background:#fff;border-radius:18px;padding:28px;box-shadow:0 24px 60px rgba(0,0,0,.35);}
    h2{font-size:20px;font-weight:800;margin-bottom:4px;}
    .sub{color:#64748b;font-size:13px;margin-bottom:18px;}
    label{display:block;font-size:13px;font-weight:600;margin:12px 0 6px;}
    input,textarea{width:100%;padding:11px 12px;border:1px solid #e2e8f0;border-radius:10px;font-size:14px;}
    input:focus,textarea:focus{outline:none;border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.12);}
    .plans{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin:6px 0 4px;}
    .plan{border:2px solid #e2e8f0;border-radius:12px;padding:12px;cursor:pointer;text-align:center;transition:.15s;}
    .plan:hover{border-color:#93c5fd;}
    .plan.active{border-color:#2563eb;background:#eff6ff;}
    .plan .nm{font-weight:700;font-size:14px;}
    .plan .pr{color:#2563eb;font-weight:800;font-size:15px;margin-top:4px;}
    .plan .ds{color:#64748b;font-size:11px;margin-top:4px;}
    .btn{width:100%;margin-top:18px;padding:13px;border:none;border-radius:10px;background:#2563eb;color:#fff;font-weight:700;font-size:15px;cursor:pointer;}
    .btn:disabled{opacity:.6;cursor:not-allowed;}
    .msg{margin-top:14px;padding:12px;border-radius:10px;font-size:13px;display:none;}
    .msg.err{background:#fef2f2;color:#b91c1c;border:1px solid #fecaca;display:block;}
    .msg.ok{background:#f0fdf4;color:#166534;border:1px solid #bbf7d0;display:block;}
    .foot{text-align:center;color:#94a3b8;font-size:12px;margin-top:18px;}
    a{color:#93c5fd;}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="brand">
      <h1><%= brand.name %></h1>
      <p>Daftarkan ISP Anda &amp; kelola billing sendiri</p>
    </div>
    <div class="card">
      <h2>Daftar Jadi Mitra / Tenant</h2>
      <p class="sub">Isi data usaha Anda, pilih paket, lalu selesaikan pembayaran. Akun tenant &amp; dashboard owner otomatis aktif setelah pembayaran terkonfirmasi.</p>

      <label>Nama PIC / Owner *</label>
      <input id="name" placeholder="Nama lengkap">
      <label>Email *</label>
      <input id="email" type="email" placeholder="email@usaha.com">
      <label>No. WhatsApp *</label>
      <input id="phone" placeholder="08xxxxxxxxxx">
      <label>Nama Perusahaan / ISP</label>
      <input id="company" placeholder="PT Jaringan Anda">
      <label>Alamat</label>
      <textarea id="address" rows="2" placeholder="Alamat usaha"></textarea>

      <label>Pilih Paket *</label>
      <div class="plans" id="plans"></div>

      <button class="btn" id="submitBtn" onclick="submitSignup()">Daftar &amp; Lanjut Bayar</button>
      <div class="msg" id="msg"></div>
    </div>
    <div class="foot">Sudah daftar? Cek status lewat tautan yang muncul setelah mendaftar.</div>
  </div>

<script>
let PLANS=[], selectedPlan=null, GATEWAY=false;
function esc(s){return String(s||'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}
function rupiah(n){return 'Rp '+Number(n||0).toLocaleString('id-ID');}
function showMsg(t,ok){const m=document.getElementById('msg');m.className='msg '+(ok?'ok':'err');m.innerHTML=t;}

async function loadPlans(){
  try{
    const r=await fetch('/pub/tenant-signup/plans').then(x=>x.json());
    if(!r.success) return showMsg('Gagal memuat paket',false);
    PLANS=r.data.plans; GATEWAY=r.data.gateway_enabled;
    const el=document.getElementById('plans');
    el.innerHTML=PLANS.map((p,i)=>`<div class="plan" data-i="${i}" onclick="pickPlan(${i})">
      <div class="nm">${esc(p.name)}</div><div class="pr">${rupiah(p.price)}</div><div class="ds">${esc(p.desc||'')}</div>
    </div>`).join('');
    if(PLANS.length) pickPlan(0);
  }catch(e){showMsg('Gagal memuat paket',false);}
}
function pickPlan(i){
  selectedPlan=PLANS[i];
  document.querySelectorAll('.plan').forEach(el=>el.classList.toggle('active',+el.dataset.i===i));
}
async function submitSignup(){
  const btn=document.getElementById('submitBtn');
  const body={
    name:document.getElementById('name').value.trim(),
    email:document.getElementById('email').value.trim(),
    phone:document.getElementById('phone').value.trim(),
    company_name:document.getElementById('company').value.trim(),
    address:document.getElementById('address').value.trim(),
    requested_slug:document.getElementById('company').value.trim()||document.getElementById('name').value.trim(),
    plan_code:selectedPlan&&selectedPlan.code
  };
  if(!body.name||!body.email||!body.phone) return showMsg('Nama, email, dan WhatsApp wajib diisi.',false);
  if(!body.plan_code) return showMsg('Pilih paket terlebih dahulu.',false);
  btn.disabled=true;btn.textContent='Memproses…';
  try{
    const r=await fetch('/pub/tenant-signup',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(x=>x.json());
    if(!r.success){btn.disabled=false;btn.textContent='Daftar & Lanjut Bayar';return showMsg(esc(r.message||'Gagal mendaftar'),false);}
    const code=r.data.signup_code;
    const statusUrl='/daftar-tenant/status/'+encodeURIComponent(code);
    if(r.gateway_enabled){
      // Coba buat transaksi gateway.
      const pay=await fetch('/pub/tenant-signup/'+encodeURIComponent(code)+'/pay',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({})}).then(x=>x.json());
      if(pay.success && pay.data && (pay.data.payment_url||pay.data.snap_url)){
        showMsg('Mengarahkan ke pembayaran…',true);
        window.location.href=pay.data.payment_url||pay.data.snap_url;
        return;
      }
      showMsg('Pendaftaran dibuat (kode <b>'+esc(code)+'</b>). '+esc(pay.message||'Lanjutkan pembayaran, lalu admin akan verifikasi.')+' <br><a href="'+statusUrl+'">Cek status pendaftaran →</a>',true);
    }else{
      showMsg('Pendaftaran berhasil! Kode Anda: <b>'+esc(code)+'</b>.<br>Silakan lakukan pembayaran (transfer) sesuai instruksi admin. Setelah pembayaran diverifikasi, akun tenant Anda otomatis aktif.<br><a href="'+statusUrl+'">Cek status pendaftaran →</a>',true);
    }
    btn.textContent='Terdaftar ✓';
  }catch(e){btn.disabled=false;btn.textContent='Daftar & Lanjut Bayar';showMsg('Terjadi kesalahan jaringan.',false);}
}
loadPlans();
</script>
</body>
</html>
