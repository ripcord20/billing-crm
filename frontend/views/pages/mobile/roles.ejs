<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title><%= title %> - <%= appName %></title>
  <link rel="stylesheet" href="/css/mobile-shell.css?v=7">
  <style>
    *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
    :root{--bg:#eff8ff;--card:#fff;--ink:#1F3849;--muted:#7c93a0;--line:#e2eefb;--blue:#0ea5e9;--blue-deep:#0284c7;--nav-h:70px;}
    body{font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--ink);padding-bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 88px);-webkit-font-smoothing:antialiased;}
    .wrap{max-width:520px;margin:0 auto;}
    .content{padding:8px 16px 20px;}
    .intro{font-size:12.5px;color:var(--muted);line-height:1.5;margin:0 2px 14px;}
    .roles{display:flex;gap:8px;overflow-x:auto;-webkit-overflow-scrolling:touch;padding:2px 0 14px;scrollbar-width:none;}
    .roles::-webkit-scrollbar{display:none;}
    .rchip{flex-shrink:0;border:1.5px solid #e2e8f0;background:#fff;border-radius:100px;padding:8px 14px;font-family:inherit;font-size:12.5px;font-weight:700;color:#5a6885;cursor:pointer;}
    .rchip.on{background:#0ea5e9;border-color:#0ea5e9;color:#fff;}
    .rchip .n{display:block;font-size:10px;font-weight:600;opacity:.8;margin-top:1px;}
    .card{background:#fff;border:1px solid #eef1f6;border-radius:18px;padding:6px 0 10px;margin-bottom:12px;box-shadow:0 8px 20px -14px rgba(30,60,120,.16);}
    .sec-h{display:flex;align-items:center;justify-content:space-between;padding:12px 16px 6px;}
    .sec-h span{font-size:11px;font-weight:800;letter-spacing:.06em;color:#94a3b8;text-transform:uppercase;}
    .sec-h button{background:none;border:none;color:var(--blue);font-size:11.5px;font-weight:700;cursor:pointer;font-family:inherit;padding:0;}
    .item{display:flex;align-items:flex-start;gap:10px;padding:10px 16px;}
    .item input{margin-top:3px;accent-color:var(--blue);width:18px;height:18px;flex-shrink:0;}
    .item b{display:block;font-size:13.5px;font-weight:700;color:var(--ink);}
    .item small{display:block;font-size:11px;color:var(--muted);margin-top:2px;}
    .empty{padding:48px 20px;text-align:center;color:var(--muted);font-size:13px;}
    .savebar{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 10px);width:calc(100% - 32px);max-width:488px;z-index:280;display:flex;gap:8px;}
    .savebar button{flex:1;padding:14px;border:none;border-radius:14px;font-family:inherit;font-size:14px;font-weight:800;cursor:pointer;}
    .btn-all{background:#fff;color:#1F3849;border:1.5px solid #e2e8f0 !important;}
    .btn-save{background:linear-gradient(135deg,#38bdf8,#0ea5e9);color:#fff;box-shadow:0 8px 18px -8px rgba(14,165,233,.6);}
    .btn-save:disabled{opacity:.55;}
    .toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 76px);background:#1F3849;color:#fff;padding:12px 20px;border-radius:13px;font-size:13px;font-weight:600;z-index:500;opacity:0;transition:opacity .25s;pointer-events:none;max-width:88vw;text-align:center;}
    .toast.show{opacity:1;} .toast.ok{background:#12946f;} .toast.err{background:#d13b42;}
    .skel{background:linear-gradient(90deg,#e7edf6 25%,#f2f6fb 50%,#e7edf6 75%);background-size:200% 100%;animation:sh 1.3s infinite;border-radius:8px;height:18px;margin:10px 16px;}
    @keyframes sh{0%{background-position:200% 0;}100%{background-position:-200% 0;}}
    .bottomnav{position:fixed;left:0;right:0;bottom:0;z-index:300;background:#fff;border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom);display:flex;}
    .bn-wrap{max-width:520px;margin:0 auto;width:100%;display:flex;height:var(--nav-h);}
    .bn-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;text-decoration:none;color:var(--muted);font-size:10px;font-weight:600;}
    .bn-item svg{width:22px;height:22px;stroke-width:2;} .bn-item.active{color:var(--blue);}
    .bn-fab{flex:0 0 auto;width:66px;display:flex;align-items:flex-start;justify-content:center;position:relative;}
    .bn-fab a,.bn-fab button{position:absolute;font-family:inherit;padding:0;cursor:pointer;top:-22px;width:58px;height:58px;border-radius:50%;background:linear-gradient(135deg,#38bdf8,#0ea5e9);display:flex;align-items:center;justify-content:center;color:#fff;text-decoration:none;box-shadow:0 12px 26px -6px rgba(14,165,233,.6);border:4px solid #fff;}
    .bn-fab svg{width:26px;height:26px;stroke-width:2.6;}
  </style>
</head>
<body>
  <%- include('../../partials/mobile-drawer', { active: active, appName: (typeof appName!=='undefined'?appName:'FLAYNET'), user: user }) %>
  <div class="wrap">
    <div class="content">
      <p class="intro">Centang modul yang boleh diakses role ini. Hak yang sama dipakai di sidebar desktop dan menu app mobile.</p>
      <div class="roles" id="roleChips"><div class="skel" style="width:90px;height:36px;border-radius:100px;margin:0;"></div></div>
      <div id="permBody"><div class="empty">Memuat hak akses…</div></div>
    </div>
  </div>

  <div class="savebar">
    <button type="button" class="btn-all" onclick="toggleAll()">Pilih semua</button>
    <button type="button" class="btn-save" id="saveBtn" onclick="savePerms()" disabled>Simpan</button>
  </div>
  <div class="toast" id="toast"></div>

  <nav class="bottomnav">
    <div class="bn-wrap">
      <a class="bn-item" href="/mobile"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span><span>Beranda</span></a>
      <a class="bn-item" href="/mobile/customers"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span><span>Pelanggan</span></a>
      <div class="bn-fab"><button type="button" onclick="FabSheet.open()" aria-label="Tambah cepat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button></div>
      <a class="bn-item" href="/mobile/finance"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/></svg></span><span>Laporan</span></a>
      <a class="bn-item" href="/mobile/monitoring"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg></span><span>Monitor</span></a>
    </div>
  </nav>

  <script>
    function getToken(){ var ls=localStorage.getItem('token'); if(ls)return ls; var m=document.cookie.match(/(?:^|;\s*)token=([^;]+)/); return m?decodeURIComponent(m[1]):null; }
    async function api(url, opts){
      var t=getToken(); var o=opts||{};
      o.headers=Object.assign({'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'}, t?{'Authorization':'Bearer '+t}:{}, o.headers||{});
      o.credentials='include';
      var r=await fetch(url,o);
      if(r.status===401){ location.href='/login'; return null; }
      var d=null; try{ d=await r.json(); }catch(_){ }
      return d;
    }
    function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
    function toast(m,t){ var el=document.getElementById('toast'); el.textContent=m; el.className='toast show'+(t?' '+t:''); setTimeout(function(){ el.classList.remove('show'); }, 2800); }

    var _roles=[], _permissions=[], _modules=[], _mobile=[], _selected=null;

    function catalog(){
      var list=[];
      if(_mobile.length){
        _mobile.forEach(function(m){ list.push({ name:m.name||('module.'+m.key), display:m.display, section:'APP MOBILE', href:m.href||'' }); });
      }
      var seen={};
      _mobile.forEach(function(m){ seen[m.name||('module.'+m.key)]=true; });
      _modules.forEach(function(m){
        if(seen[m.name]) return;
        list.push({ name:m.name, display:m.display, section:m.section||'LAINNYA', href:m.href||'' });
      });
      return list;
    }

    async function load(){
      var rolesRes, permRes;
      try{
        var pair=await Promise.all([api('/api/roles'), api('/api/permissions')]);
        rolesRes=pair[0]; permRes=pair[1];
      }catch(e){
        document.getElementById('permBody').innerHTML='<div class="empty">Gagal memuat data hak akses.</div>';
        return;
      }
      if(!(permRes&&permRes.success)){
        document.getElementById('permBody').innerHTML='<div class="empty">'+(permRes&&permRes.message?esc(permRes.message):'Tidak bisa memuat permission.')+'</div>';
        return;
      }
      _roles=(rolesRes&&rolesRes.data)||[];
      _permissions=(permRes&&permRes.data)||[];
      _modules=(permRes&&permRes.modules)||[];
      _mobile=(permRes&&permRes.mobileModules)||[];
      if(!_selected && _roles.length) _selected=_roles[0].id;
      renderChips();
      renderBody();
    }

    function renderChips(){
      document.getElementById('roleChips').innerHTML=_roles.map(function(r){
        var n=(r.permissions||[]).filter(function(p){ return String(p.name||'').indexOf('module.')===0; }).length;
        return '<button type="button" class="rchip'+(_selected==r.id?' on':'')+'" onclick="selectRole('+r.id+')">'
          +esc(r.display_name||r.name)+'<span class="n">'+n+' modul</span></button>';
      }).join('') || '<div class="empty" style="padding:12px;">Belum ada role</div>';
    }

    function selectRole(id){
      _selected=id;
      renderChips();
      renderBody();
    }

    function renderBody(){
      var role=_roles.find(function(r){ return r.id==_selected; });
      var body=document.getElementById('permBody');
      var save=document.getElementById('saveBtn');
      if(!role){ body.innerHTML='<div class="empty">Pilih role di atas.</div>'; save.disabled=true; return; }
      save.disabled=false;
      var granted={};
      (role.permissions||[]).forEach(function(p){ if(String(p.name||'').indexOf('module.')===0) granted[p.name]=true; });
      var by={};
      catalog().forEach(function(m){
        var sec=m.section||'LAINNYA';
        if(!by[sec]) by[sec]=[];
        by[sec].push(m);
      });
      var order=['APP MOBILE','OVERVIEW','MONITORING','TICKETING','WA GATEWAY','TELEGRAM','EMAIL','MANAGEMENT','SISTEM'];
      var secs=order.filter(function(s){ return by[s]; }).concat(Object.keys(by).filter(function(s){ return order.indexOf(s)<0; }));
      body.innerHTML=secs.map(function(sec){
        var items=by[sec].map(function(m){
          var perm=_permissions.find(function(p){ return p.name===m.name; });
          var pid=perm?perm.id:'';
          var checked=granted[m.name]?'checked':'';
          return '<label class="item"><input type="checkbox" class="perm-cb" data-section="'+esc(sec)+'" value="'+pid+'" '+checked+(pid?'':' disabled')+'>'
            +'<span><b>'+esc(m.display)+'</b><small>'+esc(m.href||m.name)+'</small></span></label>';
        }).join('');
        return '<div class="card" data-sec="'+esc(sec)+'"><div class="sec-h"><span>'+esc(sec)+'</span>'
          +'<button type="button" onclick="toggleSection(\''+esc(sec)+'\')">Pilih grup</button></div>'+items+'</div>';
      }).join('');
    }

    function toggleSection(sec){
      var boxes=[].slice.call(document.querySelectorAll('.perm-cb[data-section="'+sec+'"]'));
      if(!boxes.length) return;
      var allOn=boxes.every(function(b){ return b.checked; });
      boxes.forEach(function(b){ b.checked=!allOn; });
    }
    function toggleAll(){
      var boxes=[].slice.call(document.querySelectorAll('.perm-cb'));
      var allOn=boxes.length && boxes.every(function(b){ return b.checked; });
      boxes.forEach(function(b){ b.checked=!allOn; });
    }
    async function savePerms(){
      if(!_selected) return;
      var ids=[].slice.call(document.querySelectorAll('.perm-cb:checked')).map(function(b){ return parseInt(b.value,10); }).filter(Boolean);
      var uniq=[]; ids.forEach(function(id){ if(uniq.indexOf(id)<0) uniq.push(id); });
      var btn=document.getElementById('saveBtn');
      btn.disabled=true; btn.textContent='Menyimpan…';
      var d=await api('/api/roles/'+_selected,{ method:'PUT', body:JSON.stringify({ permissions: uniq }) });
      btn.disabled=false; btn.textContent='Simpan';
      if(d&&d.success){
        var idx=_roles.findIndex(function(r){ return r.id==_selected; });
        if(idx>=0) _roles[idx]=d.data;
        renderChips();
        toast('Hak akses role disimpan','ok');
      } else {
        toast((d&&d.message)||'Gagal menyimpan hak akses','err');
      }
    }

    load();
  </script>
</body>
</html>
