<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title><%= title %> - <%= appName %></title>
  <link rel="stylesheet" href="/css/mobile-shell.css?v=9">
  <style>
    *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
    :root{--bg:#eff8ff;--ink:#1F3849;--muted:#7c93a0;--line:#e2eefb;--blue:#0ea5e9;--nav-h:70px;}
    body{font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--ink);padding-bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 8px);-webkit-font-smoothing:antialiased;}
    .wrap{max-width:520px;margin:0 auto;}
    .content{padding:10px 16px 20px;}
    .cm-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:12px;}
    .cm-toolbar #mtSelectorMount{flex:1;min-width:0;}
    .cm-toolbar .mt-selector-wrap{width:100%;min-width:0;}
    .live-chip{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:20px;font-size:12px;font-weight:700;}
    .chip-idle{background:#f1f5f9;border:1px solid #e2e8f0;color:#64748b;}
    .chip-live{background:#f0fdf4;border:1px solid #bbf7d0;color:#16a34a;}
    .chip-busy{background:#eff6ff;border:1px solid #bfdbfe;color:#2563eb;}
    .live-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
    .chip-idle .live-dot{background:#94a3b8;}
    .chip-live .live-dot{background:#16a34a;}
    .chip-busy .live-dot{background:#2563eb;}
    .cm-btn{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;border:1.5px solid #e2e8f0;background:#fff;color:#374151;font-family:inherit;}
    .cm-btn svg{width:14px;height:14px;}
    .cm-btn.spin svg{animation:cmSpin 1s linear infinite;}
    @keyframes cmSpin{to{transform:rotate(360deg);}}
    .bottomnav{position:fixed;left:0;right:0;bottom:0;z-index:300;background:#fff;border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom);display:flex;}
    .bn-wrap{max-width:520px;margin:0 auto;width:100%;display:flex;height:var(--nav-h);}
    .bn-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;text-decoration:none;color:var(--muted);font-size:10px;font-weight:600;}
    .bn-item svg{width:22px;height:22px;stroke-width:2;} .bn-item.active{color:var(--blue);}
    .bn-fab{flex:0 0 auto;width:66px;display:flex;align-items:flex-start;justify-content:center;position:relative;}
    .bn-fab a,.bn-fab button{position:absolute;font-family:inherit;padding:0;cursor:pointer;top:-16px;width:52px;height:52px;border-radius:16px;background:#2563eb;display:flex;align-items:center;justify-content:center;color:#fff;text-decoration:none;box-shadow:0 10px 22px -4px rgba(37,99,235,.5);border:none;transition:transform .14s;}
    .bn-fab a:active,.bn-fab button:active{transform:scale(.92);}
    .bn-fab svg{width:26px;height:26px;stroke-width:2.6;}
  </style>
</head>
<body>
  <%- include('../../partials/mobile-drawer', { active: active, appName: (typeof appName!=='undefined'?appName:'FLAYNET'), user: user }) %>
  <div class="wrap">
    <div class="content">
      <div class="cm-toolbar">
        <div id="mtSelectorMount"></div>
        <span class="live-chip chip-idle" id="cmLiveChip">
          <span class="live-dot"></span>
          <span id="cmLiveChipTxt">Idle</span>
        </span>
        <button type="button" class="cm-btn" id="cmRefreshBtn" onclick="cmRefresh()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="23,4 23,10 17,10"/>
            <path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/>
          </svg>
          Refresh
        </button>
      </div>
      <%- include('../../partials/content-monitoring-panel') %>
    </div>
  </div>
  <nav class="bottomnav">
    <div class="bn-wrap">
      <a class="bn-item" href="/mobile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/></svg><span>Dashboard</span></a>
      <a class="bn-item" href="/mobile/customers"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><span>Customers</span></a>
      <div class="bn-fab"><button type="button" onclick="FabSheet && FabSheet.open && FabSheet.open()" aria-label="Tambah"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button></div>
      <a class="bn-item" href="/mobile/invoice"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg><span>Billing</span></a>
      <a class="bn-item" href="#" onclick="event.preventDefault(); document.querySelector('.mtop-hamb') && document.querySelector('.mtop-hamb').click()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg><span>Menu</span></a>
    </div>
  </nav>
  <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.45.2/dist/apexcharts.min.js"></script>
  <script src="/js/mikrotik-selector.js"></script>
  <script src="/js/content-monitoring.js"></script>
</body>
</html>
