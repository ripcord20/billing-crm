<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= title %> - <%= appName %></title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/topbar') %>
    <main class="page-content">
      <div class="page-header">
        <div class="page-header-left">
          <h1>Multi Tenant</h1>
          <p style="margin:4px 0 0;color:#64748b;font-size:13px;">Data pelanggan lama tetap di tenant Default. Tenant baru tidak menimpa database yang sudah jalan.</p>
        </div>
        <div class="page-header-right">
          <button class="btn btn-primary" onclick="openTenantModal()">+ Tenant</button>
        </div>
      </div>
      <div class="card">
        <div class="card-body">
          <table class="data-table">
            <thead>
              <tr><th>Nama</th><th>Slug</th><th>Status</th><th>Pelanggan</th><th>Owner</th><th>Aksi</th></tr>
            </thead>
            <tbody id="tenantTable"><tr><td colspan="6" style="text-align:center;padding:32px;color:#94a3b8;">Memuat…</td></tr></tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</div>
<div id="tenantModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1000;align-items:center;justify-content:center;">
  <div style="background:#fff;border-radius:12px;padding:24px;width:100%;max-width:440px;">
    <h3 style="margin:0 0 16px;">Tenant baru</h3>
    <label style="font-size:13px;">Nama *</label>
    <input id="tName" style="width:100%;margin:6px 0 12px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
    <label style="font-size:13px;">Nama perusahaan</label>
    <input id="tCompany" style="width:100%;margin:6px 0 12px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
    <div style="display:flex;justify-content:flex-end;gap:8px;">
      <button class="btn btn-secondary" onclick="document.getElementById('tenantModal').style.display='none'">Batal</button>
      <button class="btn btn-primary" onclick="saveTenant()">Simpan</button>
    </div>
  </div>
</div>
<div id="ownerModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1000;align-items:center;justify-content:center;">
  <div style="background:#fff;border-radius:12px;padding:24px;width:100%;max-width:440px;">
    <h3 style="margin:0 0 16px;" id="ownerTitle">Buat owner</h3>
    <input type="hidden" id="ownerTenantId">
    <label style="font-size:13px;">Nama *</label>
    <input id="oName" style="width:100%;margin:6px 0 12px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
    <label style="font-size:13px;">Email *</label>
    <input id="oEmail" type="email" style="width:100%;margin:6px 0 12px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
    <label style="font-size:13px;">Password *</label>
    <input id="oPass" type="password" style="width:100%;margin:6px 0 16px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
    <div style="display:flex;justify-content:flex-end;gap:8px;">
      <button class="btn btn-secondary" onclick="document.getElementById('ownerModal').style.display='none'">Batal</button>
      <button class="btn btn-primary" onclick="saveOwner()">Buat owner</button>
    </div>
  </div>
</div>
<script src="/js/app.js"></script>
<script src="/js/tenants.js"></script>
</body>
</html>
