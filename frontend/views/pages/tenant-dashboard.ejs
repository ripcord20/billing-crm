<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= title %> - <%= appName %></title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/topbar') %>
    <main class="page-content">
      <div class="page-header">
        <div class="page-header-left">
          <h1>Dashboard Owner Tenant</h1>
          <p style="margin:4px 0 0;color:#64748b;font-size:13px;">Ringkasan pelanggan, tagihan, dan RADIUS milik tenant Anda. Data tenant lain tidak tampil.</p>
        </div>
      </div>
      <div id="tdTenantName" style="font-size:15px;font-weight:700;margin-bottom:16px;color:#0f172a;">Memuat…</div>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px;" id="tdKpis">
        <div class="card" style="padding:16px;"><div style="font-size:12px;color:#64748b;">Pelanggan</div><div id="kCust" style="font-size:26px;font-weight:800;">—</div></div>
        <div class="card" style="padding:16px;"><div style="font-size:12px;color:#64748b;">Aktif</div><div id="kActive" style="font-size:26px;font-weight:800;color:#16a34a;">—</div></div>
        <div class="card" style="padding:16px;"><div style="font-size:12px;color:#64748b;">Isolir</div><div id="kIso" style="font-size:26px;font-weight:800;color:#dc2626;">—</div></div>
        <div class="card" style="padding:16px;"><div style="font-size:12px;color:#64748b;">Invoice unpaid</div><div id="kUnpaid" style="font-size:26px;font-weight:800;color:#d97706;">—</div></div>
        <div class="card" style="padding:16px;"><div style="font-size:12px;color:#64748b;">Lunas periode</div><div id="kPaid" style="font-size:26px;font-weight:800;">—</div></div>
        <div class="card" style="padding:16px;"><div style="font-size:12px;color:#64748b;">Overdue</div><div id="kOver" style="font-size:26px;font-weight:800;color:#b91c1c;">—</div></div>
        <div class="card" style="padding:16px;"><div style="font-size:12px;color:#64748b;">Revenue periode</div><div id="kRev" style="font-size:22px;font-weight:800;">—</div></div>
        <div class="card" style="padding:16px;"><div style="font-size:12px;color:#64748b;">Sisa tertagih</div><div id="kOut" style="font-size:22px;font-weight:800;">—</div></div>
      </div>
      <div class="card" style="padding:16px;">
        <div style="font-weight:700;margin-bottom:8px;">Aksi cepat</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <a class="btn btn-primary" href="/customers">Pelanggan</a>
          <a class="btn btn-secondary" href="/billing">Tagihan</a>
          <a class="btn btn-secondary" href="/nas">NAS</a>
          <a class="btn btn-secondary" href="/radius">RADIUS</a>
        </div>
      </div>
    </main>
  </div>
</div>
<script src="/js/app.js"></script>
<script>
document.addEventListener('DOMContentLoaded', async () => {
  const d = await App.api('/tenants/dashboard');
  if (!d?.success) {
    document.getElementById('tdTenantName').textContent = d?.message || 'Gagal memuat dashboard';
    return;
  }
  const t = d.data.tenant;
  const k = d.data.kpis;
  document.getElementById('tdTenantName').textContent = (t.company_name || t.name) + (t.status === 'suspended' ? ' (suspended)' : '');
  const idr = n => 'Rp ' + Number(n||0).toLocaleString('id-ID');
  document.getElementById('kCust').textContent = k.customers;
  document.getElementById('kActive').textContent = k.active;
  document.getElementById('kIso').textContent = k.isolated;
  document.getElementById('kUnpaid').textContent = k.unpaid;
  document.getElementById('kPaid').textContent = k.paid;
  document.getElementById('kOver').textContent = k.overdue;
  document.getElementById('kRev').textContent = idr(k.revenue);
  document.getElementById('kOut').textContent = idr(k.outstanding);
});
</script>
</body>
</html>
