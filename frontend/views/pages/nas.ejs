<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= title %> - <%= appName %></title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <style>
    .nas-page .page-content { min-width: 0; max-width: 100%; overflow-x: hidden; }
    .nas-page .page-header { align-items: flex-start; gap: 12px; flex-wrap: wrap; }
    .nas-page .page-header-left {
      display: flex; flex-direction: column; align-items: flex-start;
      min-width: 0; flex: 1 1 220px;
    }
    .nas-page .page-header-left p { max-width: 100%; }
    .nas-page .nas-table-card,
    .nas-page .nas-table-card .card-body { min-width: 0; max-width: 100%; }
    .nas-page .nas-table-card { overflow: visible; }
    .nas-page .table-scroll {
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
      width: 100%;
      max-width: 100%;
      min-width: 0;
      touch-action: pan-x pan-y;
    }
    .nas-page .table-scroll .data-table {
      min-width: 1100px;
      width: max-content;
    }
    .nas-page .table-scroll .data-table th,
    .nas-page .table-scroll .data-table td { white-space: nowrap; }
    .nas-page .table-scroll .data-table th:last-child,
    .nas-page .table-scroll .data-table td:last-child { min-width: 290px; }
    .nas-page .table-scroll .data-table td:last-child .btn {
      display: inline-flex;
      flex: 0 0 auto;
      margin-right: 4px;
    }
    .nas-page .table-scroll .data-table td .nas-mode { white-space: normal; }
    .nas-mode { display:flex; flex-direction:column; align-items:flex-start; gap:6px; min-width:148px; }
    .nas-mode-kind {
      font-size:10px; font-weight:800; letter-spacing:.08em; text-transform:uppercase;
      color:#64748b;
    }
    .nas-link {
      display:inline-flex; align-items:center; gap:8px;
      padding:6px 12px 6px 8px; border-radius:999px;
      font-size:12px; font-weight:700; line-height:1.15;
    }
    .nas-led {
      width:9px; height:9px; border-radius:50%; flex-shrink:0;
      background:#94a3b8;
    }
    .nas-link-copy { display:flex; flex-direction:column; align-items:flex-start; gap:1px; }
    .nas-link-age { font-size:10px; font-weight:600; opacity:.75; }
    .nas-link.up {
      color:#065f46;
      background:linear-gradient(180deg,#ecfdf5 0%,#d1fae5 100%);
      box-shadow:0 0 0 1px #6ee7b7, 0 8px 18px rgba(16,185,129,.16);
    }
    .nas-link.up .nas-led {
      background:#22c55e;
      box-shadow:0 0 0 4px rgba(34,197,94,.22), 0 0 12px rgba(34,197,94,.7);
      animation:nasLedPulse 1.7s ease-in-out infinite;
    }
    .nas-link.pending {
      color:#92400e;
      background:linear-gradient(180deg,#fffbeb 0%,#fef3c7 100%);
      box-shadow:0 0 0 1px #fcd34d;
    }
    .nas-link.pending .nas-led {
      background:#f59e0b;
      box-shadow:0 0 0 4px rgba(245,158,11,.2);
      animation:nasLedPulse 2s ease-in-out infinite;
    }
    .nas-link.down {
      color:#475569;
      background:linear-gradient(180deg,#f8fafc 0%,#e2e8f0 100%);
      box-shadow:0 0 0 1px #cbd5e1;
    }
    .nas-link.down .nas-led {
      background:#94a3b8;
      box-shadow:inset 0 0 0 2px #e2e8f0;
    }
    @keyframes nasLedPulse {
      0%,100% { transform:scale(1); opacity:1; }
      50% { transform:scale(.72); opacity:.65; }
    }
    [data-theme="dark"] .nas-mode-kind { color:#94a3b8; }
    [data-theme="dark"] .nas-link.up {
      color:#bbf7d0; background:linear-gradient(180deg,#064e3b,#14532d);
      box-shadow:0 0 0 1px #166534, 0 8px 18px rgba(16,185,129,.2);
    }
    [data-theme="dark"] .nas-link.pending {
      color:#fde68a; background:linear-gradient(180deg,#451a03,#78350f);
      box-shadow:0 0 0 1px #b45309;
    }
    [data-theme="dark"] .nas-link.down {
      color:#cbd5e1; background:linear-gradient(180deg,#1e293b,#0f172a);
      box-shadow:0 0 0 1px #334155;
    }
    .nas-legend {
      display:flex; flex-wrap:wrap; gap:8px; align-items:center;
      margin-top:10px;
    }
    .nas-legend .nas-link { pointer-events:none; }
    .nas-swipe-hint {
      display: none;
      margin: 8px 2px 0;
      font-size: 12px;
      color: var(--text-secondary);
    }
    @media (max-width: 768px) {
      .nas-swipe-hint { display: block; }
      .nas-page .page-header-right { width: 100%; }
      .nas-page .page-header-right .btn { flex: 1 1 auto; }
    }
  </style>
</head>
<body class="nas-page">
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/topbar') %>
    <main class="page-content">
      <div class="page-header">
        <div class="page-header-left">
          <h1>Modul NAS</h1>
          <p style="margin:4px 0 0;color:var(--text-secondary);font-size:13px;">Tombol <b>QR HP</b> = barcode untuk aplikasi WireGuard di HP (tes handshake). Tombol <b>Script</b> = tempelan RouterOS. IP tunnel = WireGuard Fiberix, bukan sewa VPN cloud.</p>
        </div>
        <div class="page-header-right" style="display:flex;gap:8px;flex-wrap:wrap;">
          <button class="btn btn-secondary" onclick="openPhoneQr()">QR HP</button>
          <button class="btn btn-secondary" onclick="openWgServer()">⚙ WireGuard Server</button>
          <button class="btn btn-secondary" onclick="importNas()">Import dari RADIUS</button>
          <button class="btn btn-primary" onclick="openNas()">+ NAS</button>
        </div>
      </div>
      <div class="card nas-table-card"><div class="card-body">
        <div class="table-scroll" id="nasTableScroll">
        <table class="data-table">
          <thead><tr><th>NAS IP</th><th>Nama</th><th>Tipe</th><th>Mode</th><th>Sync</th><th>Aksi</th></tr></thead>
          <tbody id="nasTable"><tr><td colspan="6" style="text-align:center;padding:32px;color:#94a3b8;">Memuat…</td></tr></tbody>
        </table>
        </div>
        <p class="nas-swipe-hint">Geser tabel ke kanan untuk Mode, Sync, dan tombol Aksi.</p>
        <div class="nas-legend" aria-label="Keterangan status Mode">
          <span class="nas-link up"><span class="nas-led"></span><span class="nas-link-text">Terhubung</span></span>
          <span class="nas-link down"><span class="nas-led"></span><span class="nas-link-text">Belum terhubung</span></span>
          <span class="nas-link pending"><span class="nas-led"></span><span class="nas-link-text">Belum generate</span></span>
        </div>
      </div></div>
    </main>
  </div>
</div>
<div id="nasModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1000;align-items:center;justify-content:center;">
  <div style="background:#fff;border-radius:12px;padding:24px;width:100%;max-width:460px;">
    <h3 style="margin:0 0 12px;" id="nasTitle">NAS baru</h3>
    <input type="hidden" id="nasId">
    <label style="font-size:13px;">IP NAS (nasname) *</label>
    <input id="nasIp" placeholder="192.168.22.1" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
    <label style="font-size:13px;">Shortname</label>
    <input id="nasShort" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
    <label style="font-size:13px;">Secret *</label>
    <input id="nasSecret" type="password" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
    <label style="font-size:13px;">Tipe</label>
    <input id="nasType" value="mikrotik" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
    <label style="font-size:13px;">Mode Koneksi</label>
    <select id="nasConnMode" onchange="onConnModeChange()" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
      <option value="public">Public IP (langsung)</option>
      <option value="vpn">VPN (tunnel)</option>
    </select>
    <div id="nasVpnTypeWrap" style="display:none;">
      <label style="font-size:13px;">Tipe VPN</label>
      <select id="nasVpnType" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
        <option value="wireguard">WireGuard</option>
        <option value="openvpn">OpenVPN</option>
        <option value="l2tp">L2TP / IPsec</option>
      </select>
    </div>
    <div id="nasVpnHint" style="display:none;background:#f0f6ff;border:1px dashed #9cc2ff;border-radius:8px;padding:10px;font-size:12px;color:#334155;margin:0 0 12px;">
      Alamat tunnel dialokasikan otomatis. Setelah disimpan, klik tombol
      <b>VPN</b> pada baris NAS untuk auto-generate credential/peer + config yang siap
      ditempel ke MikroTik.
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;">
      <button class="btn btn-secondary" onclick="document.getElementById('nasModal').style.display='none'">Batal</button>
      <button class="btn btn-primary" onclick="saveNas()">Simpan &amp; sync</button>
    </div>
  </div>
</div>

<!-- WireGuard Server settings modal -->
<div id="wgServerModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1000;align-items:center;justify-content:center;">
  <div style="background:#fff;border-radius:12px;padding:24px;width:100%;max-width:520px;max-height:90vh;overflow:auto;">
    <h3 style="margin:0 0 4px;">Pengaturan WireGuard Server</h3>
    <p style="margin:0 0 14px;color:#64748b;font-size:12px;">Server tunnel tempat MikroTik terhubung. Endpoint host harus dijangkau router (IP publik server, atau DNS).</p>
    <label style="font-size:13px;">Aktifkan WireGuard</label>
    <select id="wgEnabled" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
      <option value="true">Aktif</option>
      <option value="false">Nonaktif</option>
    </select>
    <label style="font-size:13px;">Endpoint Host (IP publik / domain server) *</label>
    <input id="wgEndpointHost" placeholder="vpn.isp-anda.com atau 203.0.113.10" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
    <div style="display:flex;gap:8px;">
      <div style="flex:1;"><label style="font-size:13px;">Listen Port</label>
        <input id="wgListenPort" value="51820" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;"></div>
      <div style="flex:1;"><label style="font-size:13px;">Interface</label>
        <input id="wgIface" value="wg0" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;"></div>
    </div>
    <div style="display:flex;gap:8px;">
      <div style="flex:1;"><label style="font-size:13px;">Subnet Tunnel</label>
        <input id="wgSubnet" value="10.10.0.0/24" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;"></div>
      <div style="flex:1;"><label style="font-size:13px;">Alamat Server</label>
        <input id="wgServerAddr" value="10.10.0.1" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;"></div>
    </div>
    <label style="font-size:13px;">Public Key Server</label>
    <input id="wgServerPub" readonly placeholder="(belum digenerate)" style="width:100%;margin:6px 0 6px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;background:#f8fafc;font-family:monospace;font-size:11px;">
    <button class="btn btn-sm btn-secondary" onclick="wgInitKeys()" style="margin:0 0 14px;">Generate/keys server</button>
    <div style="display:flex;justify-content:flex-end;gap:8px;">
      <button class="btn btn-secondary" onclick="document.getElementById('wgServerModal').style.display='none'">Tutup</button>
      <button class="btn btn-primary" onclick="saveWgServer()">Simpan</button>
    </div>
  </div>
</div>

<!-- VPN config output modal (WireGuard / OpenVPN / L2TP) -->
<div id="wgConfigModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1001;align-items:center;justify-content:center;">
  <div style="background:#fff;border-radius:12px;padding:24px;width:100%;max-width:640px;max-height:92vh;overflow:auto;">
    <h3 style="margin:0 0 4px;">Config VPN <span id="wgCfgType" style="text-transform:uppercase;color:#2563eb;"></span> — <span id="wgCfgNas"></span></h3>
    <p style="margin:0 0 12px;color:#b45309;font-size:12px;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:8px;">⚠ Kredensial/private key hanya ditampilkan SEKARANG. Simpan config ini — generate ulang akan membuat kredensial baru.</p>
    <div style="margin-bottom:6px;font-size:13px;font-weight:600;">Alamat Tunnel: <span id="wgCfgAddr" class="mono"></span></div>

    <div id="wgQrWrap" style="display:none;text-align:center;margin:10px 0 14px;padding:12px;border:1px dashed #cbd5e1;border-radius:12px;background:#f8fafc;">
      <img id="wgQrImg" alt="QR WireGuard HP" style="width:240px;height:240px;background:#fff;padding:8px;border-radius:12px;">
      <p id="wgQrHint" style="margin:8px 0 0;font-size:12px;color:#475569;line-height:1.5;">
        Scan di aplikasi <b>WireGuard</b> (Play Store / App Store), bukan kamera biasa.
        Satu QR = satu HP. Jangan pakai kunci yang sama dengan MikroTik yang sudah online.
      </p>
      <p id="wgQrWarn" style="display:none;margin:8px 0 0;font-size:12px;color:#9a3412;"></p>
    </div>

    <div id="wgCredWrap" style="display:none;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:10px;margin:8px 0;font-size:13px;">
      <div>Username: <b id="wgCredUser" class="mono"></b></div>
      <div>Password: <b id="wgCredPass" class="mono"></b></div>
      <div id="wgCredPskWrap">IPsec PSK: <b id="wgCredPsk" class="mono"></b></div>
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin:10px 0 4px;">
      <b style="font-size:13px;" id="wgCfgClientLabel">Config Klien</b>
      <span><button class="btn btn-sm btn-secondary" onclick="wgCopy('wgCfgClient')">Salin</button>
      <button class="btn btn-sm btn-secondary" onclick="wgDownload()">Unduh</button></span>
    </div>
    <pre id="wgCfgClient" style="background:#0f172a;color:#e2e8f0;padding:12px;border-radius:8px;font-size:12px;white-space:pre-wrap;word-break:break-all;"></pre>

    <div style="display:flex;justify-content:space-between;align-items:center;margin:10px 0 4px;">
      <b style="font-size:13px;">Perintah MikroTik (RouterOS)</b>
      <button class="btn btn-sm btn-secondary" onclick="wgCopy('wgCfgMikrotik')">Salin</button>
    </div>
    <pre id="wgCfgMikrotik" style="background:#0f172a;color:#e2e8f0;padding:12px;border-radius:8px;font-size:12px;white-space:pre-wrap;word-break:break-all;"></pre>

    <div id="wgPeerWrap">
      <div style="display:flex;justify-content:space-between;align-items:center;margin:10px 0 4px;">
        <b style="font-size:13px;" id="wgCfgPeerLabel">Blok [Peer] untuk server</b>
        <button class="btn btn-sm btn-secondary" onclick="wgCopy('wgCfgPeer')">Salin</button>
      </div>
      <pre id="wgCfgPeer" style="background:#0f172a;color:#e2e8f0;padding:12px;border-radius:8px;font-size:12px;white-space:pre-wrap;word-break:break-all;"></pre>
    </div>

    <div id="wgApplyNote" style="font-size:12px;color:#64748b;margin:6px 0 12px;"></div>
    <div style="display:flex;justify-content:flex-end;">
      <button class="btn btn-primary" onclick="document.getElementById('wgConfigModal').style.display='none'">Selesai</button>
    </div>
  </div>
</div>

<div id="rosModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1002;align-items:center;justify-content:center;">
  <div style="background:var(--bg-card);border-radius:12px;padding:24px;width:100%;max-width:720px;max-height:92vh;overflow:auto;color:var(--text);">
    <h3 style="margin:0 0 4px;">Script RouterOS — <span id="rosNas"></span></h3>
    <p id="rosHint" style="margin:0 0 12px;color:var(--text-secondary);font-size:13px;"></p>
    <div style="display:flex;gap:8px;margin:0 0 10px;flex-wrap:wrap;">
      <button class="btn btn-sm btn-primary" type="button" id="rosTabV7" onclick="showRosTab('v7')">RouterOS v7</button>
      <button class="btn btn-sm btn-secondary" type="button" id="rosTabV6" onclick="showRosTab('v6')">RouterOS v6</button>
      <button class="btn btn-sm btn-secondary" type="button" onclick="copyRos()">Salin</button>
      <button class="btn btn-sm btn-secondary" type="button" onclick="downloadRos()">Unduh .rsc</button>
    </div>
    <pre id="rosScript" class="radius-guide-pre" style="max-height:320px;background:#0f172a;color:#e2e8f0;border:none;"></pre>
    <div style="margin-top:14px;padding:12px;border:1px dashed var(--border);border-radius:10px;background:var(--bg-hover);">
      <strong style="font-size:13px;">Contoh Port Forward (belum dipasang)</strong>
      <p id="rosPfNote" style="margin:6px 0 8px;font-size:12px;color:var(--text-secondary);"></p>
      <div class="table-scroll">
      <table class="data-table" style="margin:0;">
        <thead><tr><th>Kegunaan</th><th>Publik (VPS)</th><th>Internal (tunnel)</th></tr></thead>
        <tbody id="rosPfTable"></tbody>
      </table>
      </div>
      <pre id="rosPfNft" style="margin:10px 0 0;font-size:11px;white-space:pre-wrap;color:var(--text-secondary);"></pre>
    </div>
    <p id="rosNotes" style="margin:12px 0 0;font-size:12px;color:var(--text-secondary);"></p>
    <div style="display:flex;justify-content:flex-end;margin-top:14px;">
      <button class="btn btn-primary" onclick="document.getElementById('rosModal').style.display='none'">Selesai</button>
    </div>
  </div>
</div>
<style>
  .radius-guide-pre{margin:0;padding:12px;border-radius:10px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11.5px;line-height:1.45;white-space:pre-wrap;word-break:break-all;overflow:auto;}
</style>
<script src="/js/app.js"></script>
<script src="/js/nas.js"></script>
</body>
</html>
