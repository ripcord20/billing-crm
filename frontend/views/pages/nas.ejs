<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= title %> - <%= appName %></title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/nas-palette.css?v=nas8ui">
  <style>
    :root {
      --d-bg:#eef2f9; --d-card:#fff; --d-border:#e0e7f3;
      --d-text:#0d1b3e; --d-muted:#6b7fa8;
      --d-blue1:#1a6ef5; --d-blue2:#0047cc;
      --d-green:#00c896; --d-red:#f5365c; --d-orange:#fb8c00;
    }
    .nas-page { font-family:'DM Sans',sans-serif; background:var(--d-bg) !important; }
    .nas-page .main-content { background: var(--d-bg); }
    .nas-page .page-content { min-width:0; max-width:100%; overflow-x:hidden; }
    .btn-outline { background:#fff; border:1.5px solid var(--d-border); color:#374151; padding:8px 16px; border-radius:10px; font-size:13px; font-weight:600; cursor:pointer; display:inline-flex; align-items:center; gap:6px; font-family:inherit; transition:all .15s; }
    .btn-outline:hover { background:#f8fafc; border-color:#cbd5e1; }
    .btn-blue { background:linear-gradient(135deg,#1a6ef5,#0047cc); border:none; color:#fff; padding:8px 16px; border-radius:10px; font-size:13px; font-weight:600; cursor:pointer; display:inline-flex; align-items:center; gap:6px; font-family:inherit; transition:all .15s; }
    .btn-blue:hover { opacity:.9; }
    .fin-grid, .fin-grid-4 {
      display: grid; grid-template-columns: repeat(4, 1fr);
      background: #fff; border-radius: 16px;
      border: 1px solid #e8eaed; overflow: hidden; margin-bottom: 20px;
    }
    .fin-card {
      padding: 20px 22px 18px; border-right: 1px solid #e8eaed;
      cursor: pointer; display: flex; flex-direction: column; gap: 0;
      position: relative; overflow: hidden; transition: background .15s;
      min-height: 108px;
    }
    .fin-card::before, .fin-card::after { display:none !important; content:none !important; }
    .fin-card:last-child { border-right: none; }
    .fin-card:hover { background: #fafbff; }
    .fin-card.fc-active { background: #2563eb; border-color: #2563eb; }
    .fin-card.fc-active:hover { background: #1d4ed8; }
    .fin-card.fc-active .xc-lbl  { color: rgba(255,255,255,.70); }
    .fin-card.fc-active .xc-val  { color: #fff; }
    .fin-card.fc-active .xc-sub  { color: rgba(255,255,255,.60); }
    .fin-card.fc-active .xc-pill { background: rgba(255,255,255,.20) !important; color: rgba(255,255,255,.90) !important; }
    .xc-lbl  { font-size:12px; font-weight:500; color:#64748b; margin-bottom:10px; transition:color .15s; }
    .xc-body { display:flex; align-items:flex-end; justify-content:space-between; gap:8px; }
    .xc-left { display:flex; flex-direction:column; min-width:0; }
    .xc-val  { font-size:30px; font-weight:800; color:#0f172a; letter-spacing:-1.2px; line-height:1; transition:color .15s; }
    @media(max-width:1400px){ .xc-val { font-size:26px; } }
    .xc-meta { display:flex; align-items:center; gap:5px; margin-top:6px; flex-wrap:wrap; }
    .xc-pill { display:inline-flex; align-items:center; padding:1px 6px; border-radius:100px; font-size:10.5px; font-weight:700; white-space:nowrap; flex-shrink:0; transition:all .15s; }
    .xc-blue   { background:#dbeafe; color:#1d4ed8; }
    .xc-green  { background:#dcfce7; color:#16a34a; }
    .xc-red    { background:#fee2e2; color:#dc2626; }
    .xc-amber  { background:#fef3c7; color:#b45309; }
    .xc-teal   { background:#cffafe; color:#0e7490; }
    .xc-orange { background:#ffedd5; color:#c2410c; }
    .xc-slate  { background:#f1f5f9; color:#475569; }
    .xc-sub  { font-size:11px; color:#94a3b8; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; transition:color .15s; }
    @media(max-width:700px) {
      .fin-grid, .fin-grid-4 { grid-template-columns:repeat(2,1fr); }
      .fin-card { border-right:none; border-bottom:1px solid #e8eaed; }
      .fin-card:nth-child(odd)  { border-right:1px solid #e8eaed; }
      .fin-card:nth-child(even) { border-right:none; }
      .fin-card:nth-last-child(-n+2) { border-bottom:none; }
    }
    @media(max-width:400px) {
      .fin-grid, .fin-grid-4 { grid-template-columns:1fr; }
      .fin-card { border-right:none !important; border-bottom:1px solid #e8eaed; }
      .fin-card:last-child { border-bottom:none; }
    }
    .w-card { background:var(--d-card); border:1px solid var(--d-border); border-radius:22px; box-shadow:0 2px 12px rgba(26,110,245,.05); overflow:hidden; }
    .search-wrap { position:relative; }
    .search-wrap input { width:100%;padding:10px 14px 10px 40px;box-sizing:border-box;border:1.5px solid var(--d-border);border-radius:12px;font-family:'DM Sans',sans-serif;font-size:13.5px;color:var(--d-text);background:#fff;transition:border-color .15s,box-shadow .15s;outline:none; }
    .search-wrap input:focus { border-color:var(--d-blue1);box-shadow:0 0 0 3px rgba(26,110,245,.1); }
    .search-wrap .si { position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--d-muted);pointer-events:none; }
    .filter-select { padding:10px 14px;border:1.5px solid var(--d-border);border-radius:12px;font-family:'DM Sans',sans-serif;font-size:13px;color:var(--d-text);background:#fff;cursor:pointer;outline:none;transition:border-color .15s; }
    .filter-select:focus { border-color:var(--d-blue1); }
    .nas-tbl { width:100%; border-collapse:collapse; min-width:860px; font-family:'Plus Jakarta Sans',sans-serif; }
    .nas-tbl thead th { text-align:left; padding:10px 16px; font-size:11px; font-weight:600; letter-spacing:.04em; color:var(--d-muted); border-bottom:1px solid var(--d-border); background:#f8faff; white-space:nowrap; text-transform:uppercase; }
    .nas-tbl tbody tr { border-bottom:1px solid #f0f4fc; transition:background .1s; }
    .nas-tbl tbody tr:hover { background:#f4f8ff; }
    .nas-tbl tbody tr:last-child { border-bottom:none; }
    .nas-tbl td { padding:13px 16px; vertical-align:middle; font-size:13px; color:var(--d-text); }
    .nas-tbl .mono { font-family:'DM Mono',monospace; font-size:12.5px; color:var(--d-blue1); }
    .rb { padding:4px 13px; border-radius:7px; font-family:'Plus Jakarta Sans',sans-serif; font-size:12px; font-weight:600; cursor:pointer; transition:all .15s; display:inline-flex; align-items:center; gap:4px; text-decoration:none; white-space:nowrap; border:1px solid; background:#fff; }
    .rb-edit { color:var(--d-blue1); border-color:#bfdbfe; }
    .rb-edit:hover { background:#eef3ff; }
    .rb-sync { color:#059669; border-color:#a7f3d0; }
    .rb-sync:hover { background:#f0fdf9; }
    .rb-del { color:#cbd5e0; border-color:#e2e8f0; }
    .rb-del:hover { color:var(--d-red); border-color:#fecdd3; background:#fff4f5; }
    .sb { font-size:11.5px; font-weight:600; padding:4px 11px; border-radius:20px; display:inline-flex; align-items:center; gap:5px; border:1px solid transparent; }
    .sb-dot { width:6px; height:6px; border-radius:50%; display:inline-block; flex-shrink:0; }
    .sb-up { background:#f0fdf9; color:#059669; border-color:#c6f6d5; }
    .sb-up .sb-dot { background:#059669; }
    .sb-down { background:#f7f8fc; color:var(--d-muted); border-color:#e2e8f0; }
    .sb-down .sb-dot { background:#94a3b8; }
    .sb-pending { background:#fffbf0; color:var(--d-orange); border-color:#fde68a; }
    .sb-pending .sb-dot { background:var(--d-orange); }
    .nas-mode { display:flex; flex-direction:column; align-items:flex-start; gap:6px; }
    .modal-ov { display:none; position:fixed; inset:0; background:rgba(13,27,62,.55); z-index:9999; align-items:flex-start; justify-content:center; overflow-y:auto; padding:28px 16px; backdrop-filter:blur(3px); }
    .modal-ov.active { display:flex; }
    .modal-bx { background:#fff; border-radius:22px; width:520px; max-width:100%; padding:30px; position:relative; margin:auto; box-shadow:0 24px 60px rgba(0,0,0,.18); }
    .modal-ttl { font-size:17px; font-weight:800; color:var(--d-text); margin:0 0 8px; }
    .modal-sub { font-size:13px; color:var(--d-muted); margin:0 0 22px; }
    .modal-cls { position:absolute; top:18px; right:18px; background:var(--d-bg); border:none; width:30px; height:30px; border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer; color:var(--d-muted); font-size:16px; }
    .modal-cls:hover { background:var(--d-border); }
    .flbl { display:block; font-size:11.5px; font-weight:700; color:var(--d-muted); margin-bottom:5px; letter-spacing:.04em; text-transform:uppercase; }
    .flbl .req { color:var(--d-red); }
    .finput { width:100%; box-sizing:border-box; padding:10px 12px; border:1.5px solid var(--d-border); border-radius:10px; font-family:'DM Sans',sans-serif; font-size:13.5px; color:var(--d-text); outline:none; transition:border-color .15s,box-shadow .15s; background:#fff; }
    .finput:focus { border-color:var(--d-blue1); box-shadow:0 0 0 3px rgba(26,110,245,.1); }
    .finput::placeholder { color:#b0bcdc; }
    .fhelp { margin:6px 0 0; font-size:12px; color:var(--d-muted); line-height:1.45; }
    .nas-secret-row { display:flex; gap:8px; align-items:center; margin:6px 0 10px; }
    .nas-secret-row .finput, .nas-secret-row input { flex:1 1 auto; margin:0 !important; }
    .nas-legend-note { margin:12px 20px 16px; font-size:12px; color:var(--d-muted); }
    .nas-mobile-list { display:none; }
    .nas-m-card { border:1px solid var(--d-border); border-radius:14px; padding:14px; background:#fff; }
    .nas-m-ip { font-family:'DM Mono',monospace; font-size:14px; font-weight:800; color:var(--d-text); word-break:break-all; }
    .nas-m-meta { margin-top:4px; font-size:12px; color:var(--d-muted); }
    .nas-m-row { display:flex; justify-content:space-between; align-items:flex-start; gap:10px; margin-top:10px; }
    .nas-m-sync { font-size:12px; color:var(--d-muted); text-align:right; }
    .nas-m-actions { display:flex; flex-wrap:wrap; gap:6px; margin-top:12px; }
    .nas-m-actions .rb { flex:1 1 calc(50% - 6px); justify-content:center; }
    .nas-m-empty { text-align:center; padding:40px 12px; color:var(--d-muted); font-size:13px; }
    .nas-extra-btns { display:flex; gap:8px; flex-wrap:wrap; }
    .nas-more-toggle { display:none; }
    @media (max-width: 768px) {
      .nas-page #nasTableScroll { display:none !important; }
      .nas-mobile-list { display:flex !important; flex-direction:column; gap:10px; padding:0 16px 16px; }
      .nas-extra-btns { display:none; width:100%; }
      .nas-extra-btns.is-open { display:flex; }
      .nas-more-toggle { display:inline-flex; }
      .nas-hdr-actions { width:100%; }
    }
    .nas-detail-grid { display:grid; gap:14px; }
    @media (min-width: 960px) { .nas-detail-grid { grid-template-columns: 1fr 1fr; } }
    .nas-detail-card { background:var(--d-card); border:1px solid var(--d-border); border-radius:18px; padding:18px 20px; box-shadow:0 2px 12px rgba(26,110,245,.05); }
    .nas-detail-card h2 { margin:0 0 4px; font-size:15px; font-weight:800; color:var(--d-text); }
    .nas-detail-card .sub { margin:0 0 14px; font-size:12px; color:var(--d-muted); }
    .nas-detail-card label { font-size:11.5px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:var(--d-muted); display:block; margin-bottom:5px; }
    .nas-detail-card input, .nas-detail-card select {
      width:100%; margin:0 0 12px; padding:10px 12px; border:1.5px solid var(--d-border); border-radius:10px; background:#fff; color:var(--d-text); font-family:'DM Sans',sans-serif; font-size:13.5px; outline:none;
    }
    .nas-detail-card input:focus, .nas-detail-card select:focus { border-color:var(--d-blue1); box-shadow:0 0 0 3px rgba(26,110,245,.1); }
    .nas-script-card { grid-column: 1 / -1; }
    .nas-usage { margin:12px 0 0; padding:12px; border-radius:10px; background:#f8faff; font-size:12px; color:var(--d-muted); line-height:1.55; }
    @keyframes fadeUp { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }
    .a1{animation:fadeUp .45s ease both} .a2{animation:fadeUp .45s .07s ease both}
    .a5{animation:fadeUp .45s .28s ease both}
  </style>
</head>
<body class="nas-page nas-home">
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/topbar') %>
    <main class="page-content">
      <div id="nasListView">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:12px" class="a1">
        <div>
          <div style="font-size:22px;font-weight:800;color:var(--d-text)">Modul NAS</div>
          <div style="font-size:13px;color:var(--d-muted);margin-top:2px">Network Access Server untuk RADIUS Fiberix</div>
        </div>
        <div class="nas-hdr-actions" style="display:flex;gap:8px;flex-wrap:wrap">
          <button type="button" class="btn-outline nas-more-toggle" onclick="toggleNasExtra()">Lainnya</button>
          <div class="nas-extra-btns" id="nasExtraBtns">
            <button type="button" class="btn-outline" onclick="openPhoneQr()">QR HP</button>
            <button type="button" class="btn-outline" onclick="openWgServer()">WireGuard Server</button>
            <button type="button" class="btn-outline" onclick="importNas()">Import dari RADIUS</button>
            <button type="button" class="btn-outline" onclick="openRemoteWg()">Cabang remote</button>
          </div>
          <button type="button" class="btn-blue" onclick="openNas('lan')">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            Tambah NAS
          </button>
        </div>
      </div>

      <div class="fin-grid a2">
        <div class="fin-card fc-active" id="xc-all" data-filter="all" onclick="setNasFilter('all')">
          <div class="xc-lbl">Total NAS</div>
          <div class="xc-body">
            <div class="xc-left">
              <span class="xc-val" id="scTotal">0</span>
              <div class="xc-meta">
                <span class="xc-pill xc-blue" id="xp-all">—</span>
                <span class="xc-sub">Semua metode</span>
              </div>
            </div>
          </div>
        </div>
        <div class="fin-card" id="xc-lan" data-filter="lan" onclick="setNasFilter('lan')">
          <div class="xc-lbl">LAN</div>
          <div class="xc-body">
            <div class="xc-left">
              <span class="xc-val" id="scLan">0</span>
              <div class="xc-meta">
                <span class="xc-pill xc-green" id="xp-lan">satu jaringan</span>
                <span class="xc-sub">Tanpa WireGuard</span>
              </div>
            </div>
          </div>
        </div>
        <div class="fin-card" id="xc-vpn" data-filter="vpn" onclick="setNasFilter('vpn')">
          <div class="xc-lbl">VPN</div>
          <div class="xc-body">
            <div class="xc-left">
              <span class="xc-val" id="scVpn">0</span>
              <div class="xc-meta">
                <span class="xc-pill xc-blue" id="xp-vpn">tunnel / domain</span>
                <span class="xc-sub">Beda lokasi</span>
              </div>
            </div>
          </div>
        </div>
        <div class="fin-card" id="xc-public" data-filter="public" onclick="setNasFilter('public')">
          <div class="xc-lbl">IP Publik</div>
          <div class="xc-body">
            <div class="xc-left">
              <span class="xc-val" id="scPublic">0</span>
              <div class="xc-meta">
                <span class="xc-pill xc-orange" id="xp-public">WAN static</span>
                <span class="xc-sub">Bukan Winbox ISP</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="w-card a5">
        <div style="display:flex;align-items:center;gap:10px;padding:18px 20px 16px;flex-wrap:wrap;border-bottom:1px solid var(--d-border)">
          <div class="search-wrap" style="flex:1;max-width:280px">
            <svg class="si" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input type="text" id="nasSearch" placeholder="Cari IP, nama, wilayah…" oninput="renderNasList()">
          </div>
          <select id="nasStatusFilter" class="filter-select" onchange="renderNasList()">
            <option value="">Semua status</option>
            <option value="up">Terhubung</option>
            <option value="down">Belum terhubung</option>
            <option value="pending">Belum generate</option>
          </select>
          <div style="font-size:12.5px;color:var(--d-muted);margin-left:auto;font-weight:600" id="nasCountLbl">—</div>
        </div>
        <div class="table-scroll" id="nasTableScroll" style="overflow-x:auto">
        <table class="nas-tbl">
          <thead><tr><th>NAS IP</th><th>Nama</th><th>Tipe</th><th>Mode</th><th>Sync</th><th>Aksi</th></tr></thead>
          <tbody id="nasTable"><tr><td colspan="6" style="text-align:center;padding:32px;color:#94a3b8;">Memuat…</td></tr></tbody>
        </table>
        </div>
        <div class="nas-mobile-list" id="nasMobileList"></div>
        <p class="nas-legend-note">VPN terhubung hanya jika handshake WireGuard / IP tunnel merespons. Router online di Device Management tidak dihitung.</p>
      </div>
      </div>

      <div id="nasDetailView" style="display:none;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:12px">
          <div>
            <button class="btn-outline" type="button" onclick="closeNasDetail()" style="margin-bottom:8px;padding:6px 12px;font-size:12px;">← Kembali</button>
            <div id="nasTitle" style="font-size:22px;font-weight:800;color:var(--d-text)">Detail NAS</div>
            <div style="font-size:13px;color:var(--d-muted);margin-top:2px">Informasi detail dan script konfigurasi perangkat NAS</div>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <button class="btn-outline" type="button" onclick="closeNasDetail()">Batal</button>
            <button class="btn-blue" type="button" onclick="saveNas()">Simpan &amp; sync</button>
          </div>
        </div>
        <input type="hidden" id="nasId">
        <div class="nas-detail-grid">
          <div class="nas-detail-card">
            <h2>Informasi Koneksi</h2>
            <p class="sub">Cara MikroTik mencapai RADIUS Fiberix.</p>
            <label>Metode Koneksi</label>
            <select id="nasConnMode" onchange="onConnModeChange(); previewNasScript();">
              <option value="lan">LAN</option>
              <option value="vpn">VPN</option>
              <option value="public">IP Publik</option>
            </select>
            <p id="nasLanHint" class="fhelp" style="margin:-4px 0 12px;">Satu jaringan dengan Fiberix. RADIUS ke IP LAN billing. WireGuard tidak perlu.</p>
            <p id="nasPublicHint" class="fhelp" style="display:none;margin:-4px 0 12px;">IP public static WAN CORE. nasname = IP yang dilihat FreeRADIUS, bukan IP remote Winbox ISP.</p>
            <div id="nasVpnTypeWrap" style="display:none;">
              <label>Tipe VPN</label>
              <select id="nasVpnType" onchange="previewNasScript();">
              <option value="wireguard">WireGuard Fiberix</option>
              <option value="domain">Domain / DDNS (hostddns, tunnel.web.id)</option>
              <option value="openvpn">OpenVPN</option>
              <option value="l2tp">L2TP / IPsec</option>
              </select>
            </div>
            <div id="nasVpnHint" class="fhelp" style="display:none;margin:0 0 12px;">
              WireGuard Fiberix: isi IP tunnel <code>10.201.0.x</code>. Domain VPN/DDNS: isi hostname seperti <code>cabang.tunnel.web.id</code> atau <code>xxx.hostddns.net</code>. VPN remote Winbox saja tidak menggantikan UDP RADIUS 1812.
            </div>
            <label>Host RADIUS Fiberix</label>
            <input id="nasRadiusHost" value="192.168.22.99" readonly>
          </div>
          <div class="nas-detail-card">
            <h2>Informasi Profile PPP</h2>
            <label>Range IP Pool PPP</label>
            <input id="nasPppPool" placeholder="10.2.64.2-10.2.79.254" oninput="previewNasScript();">
            <label>Local address (gateway PPP)</label>
            <input id="nasPppLocal" placeholder="10.2.64.1" oninput="previewNasScript();">
          </div>
          <div class="nas-detail-card">
            <h2>Informasi NAS</h2>
            <p class="sub">Identitas router di FreeRADIUS (nasname = IP atau domain sumber paket RADIUS).</p>
            <label>IP / Domain NAS (nasname) *</label>
            <input id="nasIp" placeholder="192.168.22.1 atau cabang.tunnel.web.id" oninput="previewNasScript();">
            <label>Shortname / nama</label>
            <input id="nasShort" placeholder="contoh: NAGA" oninput="previewNasScript();">
            <label>Wilayah</label>
            <input id="nasArea" placeholder="Pilih wilayah untuk NAS">
            <label>Secret RADIUS</label>
            <div class="nas-secret-row">
              <input id="nasSecret" type="text" placeholder="otomatis — isi hanya jika ganti" oninput="previewNasScript();" autocomplete="off">
              <button class="btn-outline" type="button" onclick="regenNasSecret()" style="padding:8px 12px;white-space:nowrap">Buat baru</button>
            </div>
            <p class="fhelp" style="margin:-4px 0 10px;">Secret dibuat otomatis saat tambah NAS. Kosongkan jika tidak diubah.</p>
            <label>Tipe</label>
            <input id="nasType" value="mikrotik">
          </div>
          <div class="nas-detail-card nas-script-card">
            <h2>Script Otomatis</h2>
            <p class="sub">Script Konfigurasi RouterOS — disesuaikan dengan NAS Anda. Tanpa L2TP/PPTP ke server cloud.</p>
            <p id="rosHint" style="margin:0 0 12px;color:var(--text-secondary);font-size:13px;"></p>
            <div style="display:flex;gap:8px;margin:0 0 10px;flex-wrap:wrap;align-items:center;">
              <span style="font-size:12px;color:var(--text-secondary);margin-right:4px;">Script Konfigurasi RouterOS:</span>
              <button class="btn-outline" type="button" id="rosTabV6" onclick="showRosTab('v6')">RouterOS v6</button>
              <button class="btn-blue" type="button" id="rosTabV7" onclick="showRosTab('v7')">RouterOS v7</button>
              <button class="btn-outline" type="button" onclick="reloadNasScript()">Muat script</button>
              <button class="btn-outline" type="button" onclick="copyRos()">Salin Script</button>
              <button class="btn-outline" type="button" onclick="downloadRos()">Unduh .rsc</button>
            </div>
            <div style="font-size:12px;font-weight:600;margin:0 0 6px;" id="rosScriptLabel">RouterOS v7 Script</div>
            <div style="font-size:11px;color:var(--text-secondary);margin:-2px 0 8px;" id="rosScriptFormat">(Format action-data)</div>
            <pre id="rosScript" class="radius-guide-pre" style="max-height:420px;background:#0f172a;color:#e2e8f0;border:none;">Isi IP NAS dan secret, lalu script muncul di sini.</pre>
            <div id="rosPfBox" style="display:none;margin-top:14px;padding:12px;border:1px dashed var(--border);border-radius:10px;background:var(--bg-hover);">
              <strong style="font-size:13px;">Lanjutan: contoh port-forward (opsional)</strong>
              <p id="rosPfNote" style="margin:6px 0 8px;font-size:12px;color:var(--text-secondary);"></p>
              <div class="table-scroll">
              <table class="data-table" style="margin:0;">
                <thead><tr><th>Kegunaan</th><th>Publik (server Fiberix)</th><th>Internal (tunnel)</th></tr></thead>
                <tbody id="rosPfTable"></tbody>
              </table>
              </div>
              <pre id="rosPfNft" style="margin:10px 0 0;font-size:11px;white-space:pre-wrap;color:var(--text-secondary);"></pre>
            </div>
            <div class="nas-usage" id="rosUsage">
              <b>Petunjuk Penggunaan</b>
              <p id="rosNotes" style="margin:8px 0 0;"></p>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- WireGuard Server settings modal -->
<div id="wgServerModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1000;align-items:center;justify-content:center;">
  <div style="background:#fff;border-radius:12px;padding:24px;width:100%;max-width:520px;max-height:90vh;overflow:auto;">
    <h3 style="margin:0 0 4px;">Pengaturan WireGuard Server</h3>
    <p style="margin:0 0 14px;color:#64748b;font-size:12px;line-height:1.5;">Ini proses di <b>server Fiberix yang sama</b> (kantor/LAN), <b>bukan VPN sewa</b>. Lewati seluruh pengaturan ini jika MikroTik sudah satu jaringan dengan Fiberix — pakai mode LAN. Isi endpoint hanya jika router di lokasi lain harus menembus ke server ini.</p>
    <p id="wgRuntime" style="margin:0 0 12px;font-size:12px;color:#64748b;"></p>
    <label style="font-size:13px;">Aktifkan WireGuard</label>
    <select id="wgEnabled" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
      <option value="true">Aktif</option>
      <option value="false">Nonaktif</option>
    </select>
    <label style="font-size:13px;">Endpoint Host (IP server Fiberix / DNS) *</label>
    <input id="wgEndpointHost" placeholder="192.168.22.9 atau fiberix.my.id" style="width:100%;margin:6px 0 4px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
    <p style="margin:0 0 10px;font-size:11px;color:#64748b;">IP LAN (192.168.x / 10.x) = benar untuk jaringan lokal. IP publik/DNS hanya jika router di luar LAN.</p>
    <div style="display:flex;gap:8px;">
      <div style="flex:1;"><label style="font-size:13px;">Listen Port</label>
        <input id="wgListenPort" value="51820" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;"></div>
      <div style="flex:1;"><label style="font-size:13px;">Interface</label>
        <input id="wgIface" value="wg0" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;"></div>
    </div>
    <div style="display:flex;gap:8px;">
      <div style="flex:1;"><label style="font-size:13px;">Subnet Tunnel</label>
        <input id="wgSubnet" value="10.10.0.0/24" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;"></div>
      <div style="flex:1;"><label style="font-size:13px;">Alamat Server</label>
        <input id="wgServerAddr" value="10.10.0.1" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;"></div>
    </div>
    <label style="font-size:13px;">Public Key Server</label>
    <input id="wgServerPub" readonly placeholder="(belum digenerate)" style="width:100%;margin:6px 0 6px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;background:#f8fafc;font-family:monospace;font-size:11px;">
    <button class="btn btn-sm btn-secondary" onclick="wgInitKeys()" style="margin:0 0 8px;">Generate/keys server</button>
    <button class="btn btn-sm btn-primary" onclick="wgApplyServer()" style="margin:0 0 14px;">Aktifkan interface di server ini</button>
    <div style="display:flex;justify-content:flex-end;gap:8px;">
      <button class="btn btn-secondary" onclick="document.getElementById('wgServerModal').style.display='none'">Tutup</button>
      <button class="btn btn-primary" onclick="saveWgServer()">Simpan</button>
    </div>
  </div>
</div>

<!-- VPN config output modal (WireGuard / OpenVPN / L2TP) -->
<div id="wgConfigModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1001;align-items:center;justify-content:center;">
  <div style="background:#fff;border-radius:12px;padding:24px;width:100%;max-width:640px;max-height:92vh;overflow:auto;">
    <h3 style="margin:0 0 4px;">Config VPN <span id="wgCfgType" style="text-transform:uppercase;color:#2563eb;"></span> — <span id="wgCfgNas"></span></h3>
    <p style="margin:0 0 12px;color:#b45309;font-size:12px;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:8px;">⚠ Kredensial/private key hanya ditampilkan SEKARANG. Simpan config ini — generate ulang akan membuat kredensial baru.</p>
    <div style="margin-bottom:6px;font-size:13px;font-weight:600;">Alamat Tunnel: <span id="wgCfgAddr" class="mono"></span></div>

    <div id="wgQrWrap" style="display:none;text-align:center;margin:10px 0 14px;padding:12px;border:1px dashed #cbd5e1;border-radius:12px;background:#f8fafc;">
      <img id="wgQrImg" alt="QR WireGuard HP" style="width:240px;height:240px;background:#fff;padding:8px;border-radius:12px;">
      <p id="wgQrHint" style="margin:8px 0 0;font-size:12px;color:#475569;line-height:1.5;">
        Scan di aplikasi <b>WireGuard</b> (Play Store / App Store), bukan kamera biasa.
        Satu QR = satu HP. Jangan pakai kunci yang sama dengan MikroTik yang sudah online.
      </p>
      <p id="wgQrWarn" style="display:none;margin:8px 0 0;font-size:12px;color:#9a3412;"></p>
    </div>

    <div id="wgCredWrap" style="display:none;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:10px;margin:8px 0;font-size:13px;">
      <div>Username: <b id="wgCredUser" class="mono"></b></div>
      <div>Password: <b id="wgCredPass" class="mono"></b></div>
      <div id="wgCredPskWrap">IPsec PSK: <b id="wgCredPsk" class="mono"></b></div>
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin:10px 0 4px;">
      <b style="font-size:13px;" id="wgCfgClientLabel">Config Klien</b>
      <span><button class="btn btn-sm btn-secondary" onclick="wgCopy('wgCfgClient')">Salin</button>
      <button class="btn btn-sm btn-secondary" onclick="wgDownload()">Unduh</button></span>
    </div>
    <pre id="wgCfgClient" style="background:#0f172a;color:#e2e8f0;padding:12px;border-radius:8px;font-size:12px;white-space:pre-wrap;word-break:break-all;"></pre>

    <div style="display:flex;justify-content:space-between;align-items:center;margin:10px 0 4px;">
      <b style="font-size:13px;">Perintah MikroTik (RouterOS)</b>
      <button class="btn btn-sm btn-secondary" onclick="wgCopy('wgCfgMikrotik')">Salin</button>
    </div>
    <pre id="wgCfgMikrotik" style="background:#0f172a;color:#e2e8f0;padding:12px;border-radius:8px;font-size:12px;white-space:pre-wrap;word-break:break-all;"></pre>

    <div id="wgPeerWrap">
      <div style="display:flex;justify-content:space-between;align-items:center;margin:10px 0 4px;">
        <b style="font-size:13px;" id="wgCfgPeerLabel">Blok [Peer] untuk server</b>
        <button class="btn btn-sm btn-secondary" onclick="wgCopy('wgCfgPeer')">Salin</button>
      </div>
      <pre id="wgCfgPeer" style="background:#0f172a;color:#e2e8f0;padding:12px;border-radius:8px;font-size:12px;white-space:pre-wrap;word-break:break-all;"></pre>
    </div>

    <div id="wgApplyNote" style="font-size:12px;color:#64748b;margin:6px 0 12px;"></div>
    <div style="display:flex;justify-content:flex-end;">
      <button class="btn btn-primary" onclick="document.getElementById('wgConfigModal').style.display='none'">Selesai</button>
    </div>
  </div>
</div>

<!-- Cabang remote: auto peer CORE 1 + script tempel MikroTik -->
<div id="remoteWgModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1002;align-items:center;justify-content:center;">
  <div style="background:#fff;border-radius:12px;padding:24px;width:100%;max-width:640px;max-height:92vh;overflow:auto;">
    <h3 style="margin:0 0 4px;">Cabang remote — peer VPS Nevacloud</h3>
    <p style="margin:0 0 14px;color:#9a3412;font-size:12px;line-height:1.5;">Satu klik: Fiberix pasang peer di VPS <code>103.169.206.24:51820</code>, lalu Anda tempel script di terminal MikroTik cabang. Bukan VPN Fiberix dan bukan CORE 1.</p>

    <div id="remoteWgForm">
      <label style="font-size:13px;">Nama cabang *</label>
      <input id="rwgName" placeholder="contoh: CORE 3 PINRANG" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
      <label style="font-size:13px;">Secret RADIUS *</label>
      <input id="rwgSecret" type="password" placeholder="secret yang sama di /radius add" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
      <label style="font-size:13px;">Lokasi (Device Management)</label>
      <input id="rwgLocation" placeholder="opsional" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
      <div style="display:flex;gap:8px;">
        <div style="flex:1;"><label style="font-size:13px;">API port</label>
          <input id="rwgApiPort" value="80" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;"></div>
        <div style="flex:1;"><label style="font-size:13px;">API user</label>
          <input id="rwgApiUser" value="admin" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;"></div>
      </div>
      <label style="font-size:13px;">API password (Device Management)</label>
      <input id="rwgApiPass" type="password" placeholder="opsional, bisa diisi nanti" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;">
      <div style="display:flex;gap:8px;">
        <div style="flex:1;"><label style="font-size:13px;">PPP pool</label>
          <input id="rwgPppPool" value="10.2.64.2-10.2.79.254" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;"></div>
        <div style="flex:1;"><label style="font-size:13px;">PPP local</label>
          <input id="rwgPppLocal" value="10.2.64.1" style="width:100%;margin:6px 0 10px;padding:8px;border:1px solid #e2e8f0;border-radius:8px;"></div>
      </div>
      <p id="rwgFormErr" style="display:none;margin:0 0 10px;font-size:12px;color:#b91c1c;"></p>
      <div style="display:flex;justify-content:flex-end;gap:8px;">
        <button class="btn btn-secondary" type="button" onclick="closeRemoteWg()">Batal</button>
        <button class="btn btn-primary" type="button" id="rwgSubmit" onclick="submitRemoteWg()">Buat &amp; salin script</button>
      </div>
    </div>

    <div id="remoteWgResult" style="display:none;">
      <p style="margin:0 0 10px;font-size:13px;color:#14532d;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:10px;">
        Peer VPS siap. IP tunnel: <b id="rwgTunnelIp" class="mono"></b>
        · endpoint <span id="rwgEndpoint" class="mono"></span>
        · NAS #<span id="rwgNasId"></span>
      </p>
      <p style="margin:0 0 8px;font-size:12px;color:#b45309;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:8px;">Private key ada di script ini. Simpan / tempel sekarang. Generate ulang membuat kunci baru.</p>
      <div style="display:flex;justify-content:space-between;align-items:center;margin:10px 0 4px;">
        <b style="font-size:13px;">Script MikroTik (tempel di New Terminal)</b>
        <span>
          <button class="btn btn-sm btn-secondary" type="button" onclick="copyRemoteWg()">Salin</button>
          <button class="btn btn-sm btn-secondary" type="button" onclick="downloadRemoteWg()">Unduh .rsc</button>
        </span>
      </div>
      <pre id="rwgScript" style="background:#0f172a;color:#e2e8f0;padding:12px;border-radius:8px;font-size:12px;white-space:pre-wrap;word-break:break-all;max-height:360px;overflow:auto;"></pre>
      <p id="rwgNotes" style="margin:8px 0 12px;font-size:12px;color:#64748b;"></p>
      <div style="display:flex;justify-content:flex-end;gap:8px;">
        <button class="btn btn-secondary" type="button" onclick="openRemoteWg()">Cabang lain</button>
        <button class="btn btn-primary" type="button" onclick="closeRemoteWg()">Selesai</button>
      </div>
    </div>
  </div>
</div>

