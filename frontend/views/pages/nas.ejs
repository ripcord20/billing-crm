<div id="nasAddModal" class="modal-ov" onclick="if(event.target===this)closeNasAdd()">
  <div class="modal-bx" role="dialog" aria-labelledby="nasAddTitle">
    <button type="button" class="modal-cls" onclick="closeNasAdd()" aria-label="Tutup">✕</button>
    <div class="modal-ttl" id="nasAddTitle">Tambah NAS</div>
    <p class="modal-sub">Network Access Server baru ke FreeRADIUS Fiberix</p>
    <form id="nasAddForm" onsubmit="submitNasAdd(event)">
      <div style="display:grid;gap:14px">
        <div>
          <label class="flbl" for="addNasName">Nama NAS <span class="req">*</span></label>
          <input class="finput" id="addNasName" required placeholder="Contoh: Router Pusat" autocomplete="off">
        </div>
        <div>
          <label class="flbl" for="addNasDesc">Deskripsi</label>
          <input class="finput" id="addNasDesc" placeholder="Contoh: Router untuk area pusat kota">
        </div>
        <div>
          <label class="flbl" for="addNasMode">Metode Koneksi <span class="req">*</span></label>
          <select class="finput" id="addNasMode" onchange="pickNasMode(this.value)">
            <option value="lan">LAN</option>
            <option value="vpn">VPN</option>
            <option value="public">IP Publik</option>
          </select>
          <p class="fhelp" id="addNasModeHint">Satu jaringan dengan Fiberix. WireGuard tidak perlu.</p>
        </div>
        <div>
          <label class="flbl" for="addNasArea">Wilayah</label>
          <input class="finput" id="addNasArea" list="nasAreaList" placeholder="Pilih wilayah untuk NAS">
          <datalist id="nasAreaList"></datalist>
        </div>
        <div>
          <label class="flbl" for="addNasIp">IP / Domain NAS <span class="req">*</span></label>
          <input class="finput" id="addNasIp" required placeholder="192.168.22.1" autocomplete="off">
          <p class="fhelp" id="addNasIpHint">IP sumber paket RADIUS (nasname).</p>
        </div>
        <p class="fhelp" id="addNasSecretNote">Secret RADIUS dibuat otomatis. Nilai aslinya masuk ke script MikroTik setelah NAS tersimpan.</p>
      </div>
      <div style="display:flex;gap:10px;margin-top:22px">
        <button type="submit" class="btn-blue" id="addNasSubmit" style="flex:1;justify-content:center;padding:11px">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Tambah NAS
        </button>
        <button type="button" class="btn-outline" onclick="closeNasAdd()" style="padding:11px 22px">Batal</button>
      </div>
    </form>
  </div>
</div>
<script src="/js/nas.js?v=nas8ui"></script>
