        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="modal-tabs" id="modalTabs">
      <button class="modal-tab active" data-tab="odc" onclick="switchTab('odc',this)">ODC</button>
      <button class="modal-tab" data-tab="odp" onclick="switchTab('odp',this)">ODP</button>
      <button class="modal-tab" data-tab="jb" onclick="switchTab('jb',this)">JB</button>
      <button class="modal-tab" data-tab="tower" onclick="switchTab('tower',this)">Tiang</button>
      <button class="modal-tab" data-tab="pop" onclick="switchTab('pop',this)">POP</button>
      <button class="modal-tab" data-tab="rack" onclick="switchTab('rack',this)">Rack</button>
      <button class="modal-tab" data-tab="server" onclick="switchTab('server',this)">Server</button>
      <button class="modal-tab" data-tab="switch" onclick="switchTab('switch',this)">Switch</button>
      <button class="modal-tab" data-tab="otb" onclick="switchTab('otb',this)">OTB</button>
      <button class="modal-tab" data-tab="customer" onclick="switchTab('customer',this)">Pelanggan</button>
    </div>
    <div class="modal-body">
      <!-- ── Koordinat Section ── -->
      <div style="background:var(--bg-secondary);border-radius:10px;padding:12px 14px;margin-bottom:14px;border:1.5px solid var(--border)">
        <!-- Header row -->
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
          <div style="display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--text-primary)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Lokasi
          </div>
          <div style="display:flex;gap:6px">
            <!-- Toggle manual input -->
            <button type="button" id="coordManualToggle" onclick="toggleManualCoord()"
              style="display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:6px;border:1.5px solid var(--border);background:var(--bg-card);color:var(--text-secondary);font-size:10px;font-weight:600;cursor:pointer;font-family:inherit">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4z"/></svg>
              Input Manual
            </button>
            <!-- Pilih dari peta -->
            <button type="button" id="rePickBtn" onclick="rePick()"
              style="display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:6px;border:1.5px solid var(--primary);background:#eff6ff;color:var(--primary);font-size:10px;font-weight:600;cursor:pointer;font-family:inherit">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Pilih di Peta
            </button>
          </div>
        </div>

        <!-- Koordinat display -->
        <div id="coordPreviewWrap" style="display:flex;align-items:center;gap:8px">
          <div id="coordDot" style="width:8px;height:8px;border-radius:50%;background:#e2e8f0;flex-shrink:0"></div>
          <span id="coordPreview" style="font-size:12px;color:var(--text-secondary)">Belum dipilih — klik tombol di atas</span>
        </div>

        <!-- Manual input (hidden by default) -->
        <div id="coordManualWrap" style="display:none;margin-top:10px;padding-top:10px;border-top:1px solid var(--border)">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
            <div>
              <label style="font-size:10px;font-weight:600;color:var(--text-secondary);letter-spacing:.05em;text-transform:uppercase;display:block;margin-bottom:4px">Latitude</label>
              <input type="number" id="manualLat" step="0.000001" placeholder="-6.391581"
                style="width:100%;padding:7px 10px;border-radius:7px;border:1.5px solid var(--border);background:var(--bg-card);font-size:12px;font-family:monospace;color:var(--text-primary);outline:none"
                oninput="applyManualCoord()">
            </div>
            <div>
              <label style="font-size:10px;font-weight:600;color:var(--text-secondary);letter-spacing:.05em;text-transform:uppercase;display:block;margin-bottom:4px">Longitude</label>
              <input type="number" id="manualLng" step="0.000001" placeholder="106.457346"
                style="width:100%;padding:7px 10px;border-radius:7px;border:1.5px solid var(--border);background:var(--bg-card);font-size:12px;font-family:monospace;color:var(--text-primary);outline:none"
                oninput="applyManualCoord()">
            </div>
          </div>
          <!-- Paste koordinat (format: lat,lng atau lat lng) -->
          <div style="margin-top:8px">
            <label style="font-size:10px;font-weight:600;color:var(--text-secondary);letter-spacing:.05em;text-transform:uppercase;display:block;margin-bottom:4px">Paste Koordinat</label>
            <div style="display:flex;gap:6px">
              <input type="text" id="pasteCoord" placeholder="-6.391581, 106.457346 atau dari Google Maps"
                style="flex:1;padding:7px 10px;border-radius:7px;border:1.5px solid var(--border);background:var(--bg-card);font-size:11px;color:var(--text-primary);outline:none;font-family:monospace"
                onkeydown="if(event.key==='Enter')parseCoordPaste()">
              <button type="button" onclick="parseCoordPaste()"
                style="padding:7px 12px;border-radius:7px;border:none;background:var(--primary);color:#fff;font-size:11px;font-weight:700;cursor:pointer;font-family:inherit;white-space:nowrap">
                Terapkan
              </button>
            </div>
            <div style="font-size:10px;color:var(--text-secondary);margin-top:4px">Mendukung format: Google Maps, decimal, atau DMS</div>
          </div>
        </div>
