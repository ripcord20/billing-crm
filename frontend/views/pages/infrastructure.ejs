    <div class="confirm-msg" id="confirmMsg">Apakah Anda yakin?</div>
    <div class="confirm-actions">
      <button class="confirm-cancel" id="confirmCancelBtn">Batal</button>
      <button class="confirm-ok" id="confirmOkBtn">OK</button>
    </div>
  </div>
