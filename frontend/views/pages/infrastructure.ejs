          <div class="stat-item"><div class="stat-dot" style="background:#334155"></div><span class="stat-val" id="st-server">0</span><span class="stat-lbl">Server</span></div>
          <div class="stat-item"><div class="stat-dot" style="background:#0284c7"></div><span class="stat-val" id="st-switch">0</span><span class="stat-lbl">Switch</span></div>
          <div class="stat-item"><div class="stat-dot" style="background:#c2410c"></div><span class="stat-val" id="st-otb">0</span><span class="stat-lbl">OTB</span></div>
          <div class="stat-item"><div class="stat-dot" style="background:#ef4444"></div><span class="stat-val" id="st-occ-full">0</span><span class="stat-lbl">ODP penuh</span></div>
          <div class="stat-item"><div class="stat-dot" style="background:#f59e0b"></div><span class="stat-val" id="st-occ-warn">0</span><span class="stat-lbl">Hampir penuh</span></div>
