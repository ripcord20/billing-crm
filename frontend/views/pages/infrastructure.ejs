<script>
// ═════════ Global customConfirm({title, message, variant, okText, cancelText}) → Promise<boolean> ═════════
// Ganti native confirm() dengan dialog modern yang konsisten dengan tema halaman.
window.customConfirm = function(opts) {
  opts = opts || {};
  const ov     = document.getElementById('customConfirmOv');
  const icon   = document.getElementById('confirmIcon');
  const title  = document.getElementById('confirmTitle');
  const msg    = document.getElementById('confirmMsg');
  const okBtn  = document.getElementById('confirmOkBtn');
  const canBtn = document.getElementById('confirmCancelBtn');

  title.textContent = opts.title   || 'Konfirmasi';
  msg.textContent   = opts.message || 'Apakah Anda yakin?';
  okBtn.textContent  = opts.okText     || 'OK';
  canBtn.textContent = opts.cancelText || 'Batal';

  const variant = opts.variant || 'danger'; // danger | warning | info
  icon.className  = 'confirm-icon ' + variant;
  okBtn.className = 'confirm-ok '   + (variant === 'danger' ? 'danger' : '');

  // Swap icon SVG sesuai variant
  let iconSvg = '';
  if (variant === 'danger') {
    iconSvg = '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>';
  } else if (variant === 'warning') {
    iconSvg = '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
  } else {
    iconSvg = '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
  }
  icon.innerHTML = iconSvg;

  ov.classList.add('active');

  return new Promise(resolve => {
    function close(result) {
      ov.classList.remove('active');
      okBtn.removeEventListener('click', onOk);
      canBtn.removeEventListener('click', onCancel);
      ov.removeEventListener('click', onBgClick);
      document.removeEventListener('keydown', onKey);
      resolve(result);
    }
    function onOk()       { close(true);  }
    function onCancel()   { close(false); }
    function onBgClick(e) { if (e.target === ov) close(false); }
    function onKey(e)     {
      if (e.key === 'Escape') close(false);
      else if (e.key === 'Enter') close(true);
    }
    okBtn.addEventListener('click', onOk);
    canBtn.addEventListener('click', onCancel);
    ov.addEventListener('click', onBgClick);
    document.addEventListener('keydown', onKey);
    setTimeout(() => okBtn.focus(), 50);
  });
};
</script>

<script>
// ═════════ Search bar di peta — searchable index + dropdown + auto-zoom ═════════
// Strategi:
//   - Bangun index gabungan dari allInfraPoints (ODC/ODP/POP/Tiang/Customer-InfraPoint)
//     + dari /customers/map (customer raw, untuk yang sudah ada lat/lng tapi
//     mungkin belum sinkron sebagai InfrastructurePoint).
//   - Match nama (case-insensitive). Untuk customer juga match customer_id & phone.
//   - Dropdown grouped per type (Customer/ODP/ODC/POP/Tiang).
//   - Klik item → pan + zoom ke titik + buka popup.
(function() {
  let searchIndex = [];              // [{id, name, type, lat, lng, meta, marker?}]
  let searchHighlightIdx = -1;       // untuk keyboard navigation
  let _searchIndexBuiltAt = 0;

  const TYPE_META = {
    customer: { label: 'Pelanggan', color: '#f97316', order: 1 },
    odp:      { label: 'ODP',       color: '#3b82f6', order: 2 },
    odc:      { label: 'ODC',       color: '#1d4ed8', order: 3 },
    jb:       { label: 'JB',        color: '#0d9488', order: 4 },
    pop:      { label: 'POP',       color: '#ef4444', order: 5 },
    tower:    { label: 'Tiang',     color: '#475569', order: 6 },
    rack:     { label: 'Rack',      color: '#7c3aed', order: 7 },
    server:   { label: 'Server',    color: '#334155', order: 8 },
    switch:   { label: 'Switch',    color: '#0284c7', order: 9 },
    otb:      { label: 'OTB',       color: '#c2410c', order: 10 },
  };

  // Bangun index dari marker yang BENAR-BENAR sedang ada di peta.
  // Sumber: window.markersById (InfrastructurePoint) + window.customerMarkersById (customer raw).
  // Ini menjamin search hanya memunculkan titik yang user lihat — tidak ada
  // "ghost result" untuk customer tanpa koord, atau untuk titik yang sudah
  // ke-filter keluar.
  function buildSearchIndex() {
    searchIndex = [];

    // 1. InfrastructurePoint markers (ODC, ODP, POP, Tiang, dan Customer-as-point)
    const infraMarkers = window.markersById || {};
    Object.keys(infraMarkers).forEach(idStr => {
      const marker = infraMarkers[idStr];
      if (!marker) return;
      const pt = marker._infraPt;
      if (!pt || pt.latitude == null || pt.longitude == null) return;
      // Hanya masuk index kalau marker masih attached ke map
      if (typeof marker._map === 'undefined' || marker._map === null) return;
      searchIndex.push({
        key:  `infra-${pt.id}`,
        ref:  'infra',
        id:   pt.id,
        name: pt.name || '(Tanpa nama)',
        type: pt.type || 'other',
        lat:  +pt.latitude,
        lng:  +pt.longitude,
        meta: pt.address || (pt.parent_id ? `Parent #${pt.parent_id}` : '') || '',
      });
    });

    // 2. Customer markers (yang dirender via addCustomerMarker, biasanya
    // sudah punya InfrastructurePoint pasangannya tapi di-mark sebagai pelanggan
    // dengan icon rumah). Hindari duplikat — kalau Customer.id sudah masuk
    // via InfrastructurePoint (metadata.customer_id), skip.
    const linkedCustIds = new Set();
    searchIndex.forEach(it => {
      if (it.type !== 'customer') return;
      // pt.metadata.customer_id dipakai untuk mapping
      const marker = infraMarkers[it.id];
      if (!marker || !marker._infraPt) return;
      let meta = marker._infraPt.metadata;
      if (typeof meta === 'string') {
        try { meta = JSON.parse(meta); } catch (_) { meta = null; }
      }
      if (meta && meta.customer_id != null) linkedCustIds.add(Number(meta.customer_id));
    });

    const custMarkers = window.customerMarkersById || {};
    Object.keys(custMarkers).forEach(idStr => {
      const marker = custMarkers[idStr];
      if (!marker) return;
      const c = marker._custData;
      if (!c || c.latitude == null || c.longitude == null) return;
      // Skip kalau marker tidak attached
      if (typeof marker._map === 'undefined' || marker._map === null) return;
      // Skip kalau sudah ke-cover via InfrastructurePoint
      if (linkedCustIds.has(Number(c.id))) return;
      searchIndex.push({
        key:  `cust-${c.id}`,
        ref:  'customer',
        id:   c.id,
        name: c.name || '(Tanpa nama)',
        type: 'customer',
        lat:  +c.latitude,
        lng:  +c.longitude,
        meta: c.customer_id || c.phone || c.address || '',
        customerId: c.customer_id,
        phone: c.phone,
      });
    });

    _searchIndexBuiltAt = Date.now();
  }

  // Highlight substring di nama untuk feedback visual
  function highlightMatch(text, query) {
    if (!query) return _escHtml(text);
    const lowText = text.toLowerCase();
    const lowQ    = query.toLowerCase();
    const idx = lowText.indexOf(lowQ);
    if (idx === -1) return _escHtml(text);
    return _escHtml(text.slice(0, idx))
         + '<mark>' + _escHtml(text.slice(idx, idx + query.length)) + '</mark>'
         + _escHtml(text.slice(idx + query.length));
  }

  function _escHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
    }[c]));
  }

  // Filter index berdasarkan query
  function filterSearch(query) {
    const q = query.trim().toLowerCase();
    if (!q) return [];
    return searchIndex.filter(it => {
      if (it.name && it.name.toLowerCase().includes(q)) return true;
      if (it.customerId && String(it.customerId).toLowerCase().includes(q)) return true;
      if (it.phone && String(it.phone).includes(q)) return true;
      if (it.meta && String(it.meta).toLowerCase().includes(q)) return true;
      return false;
    });
  }

  // Group by type lalu render dropdown
  function renderDropdown(results, query) {
    const dd = document.getElementById('mapSearchDropdown');
    if (!results.length) {
      dd.innerHTML = '<div class="map-search-empty">Tidak ada hasil untuk "' + _escHtml(query) + '"</div>';
      dd.classList.add('open');
      return;
    }

    // Group
    const groups = {};
    results.forEach(r => {
      if (!groups[r.type]) groups[r.type] = [];
      groups[r.type].push(r);
    });

    // Sort group berdasarkan TYPE_META.order, sort item dalam group alfabetis
    const sortedTypes = Object.keys(groups).sort((a, b) => {
      const oa = TYPE_META[a]?.order || 99;
      const ob = TYPE_META[b]?.order || 99;
      return oa - ob;
    });

    let html = '';
    let globalIdx = 0;
    sortedTypes.forEach(t => {
      const meta = TYPE_META[t] || { label: t.toUpperCase(), color: '#94a3b8' };
      groups[t].sort((a, b) => a.name.localeCompare(b.name));
      const items = groups[t].slice(0, 15); // batasi 15 per group

      html += '<div class="map-search-group">';
      html += '<div class="map-search-group-label">';
      html += '<span class="group-dot" style="background:' + meta.color + '"></span>';
      html += meta.label + ' <span style="opacity:.6;font-weight:600">(' + groups[t].length + ')</span>';
      html += '</div>';

      items.forEach(it => {
        html += '<div class="map-search-item" data-idx="' + globalIdx + '" '
              + 'onclick="window._mapSearchPick(' + globalIdx + ')">';
        html += '<div class="item-icon" style="background:' + meta.color + '">';
        html += _typeIconSvg(t);
        html += '</div>';
        html += '<div class="item-text">';
        html += '<div class="item-name">' + highlightMatch(it.name, query) + '</div>';
        if (it.meta) {
          html += '<div class="item-meta">' + _escHtml(String(it.meta)) + '</div>';
        }
        html += '</div></div>';
        // Simpan ref ke globalIdx → item
        results._flatRef = results._flatRef || {};
        results._flatRef[globalIdx] = it;
        globalIdx++;
      });

      if (groups[t].length > 15) {
        html += '<div class="map-search-empty" style="padding:6px 14px;font-size:11px">'
              + '+ ' + (groups[t].length - 15) + ' lagi — persempit pencarian'
              + '</div>';
      }
      html += '</div>';
    });

    // Save current results for keyboard nav
    window._mapSearchCurrentResults = results;
    dd.innerHTML = html;
    dd.classList.add('open');
    searchHighlightIdx = -1;
  }

  function _typeIconSvg(t) {
    const common = 'width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"';
    if (t === 'customer') return '<svg ' + common + '><path d="M3 9.5L12 3l9 6.5V21a1 1 0 01-1 1h-5v-7h-6v7H4a1 1 0 01-1-1z"/></svg>';
    if (t === 'odp')      return '<svg ' + common + '><rect x="5" y="9" width="14" height="11" rx="1.5"/><path d="M9 9V6a3 3 0 016 0v3"/></svg>';
    if (t === 'odc')      return '<svg ' + common + '><rect x="4" y="5" width="16" height="14" rx="2"/><line x1="8" y1="9" x2="16" y2="9"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="12" y2="17"/></svg>';
    if (t === 'pop')      return '<svg ' + common + '><path d="M12 2L2 7l10 5 10-5-10-5z"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>';
    if (t === 'tower')    return '<svg ' + common + '><line x1="12" y1="3" x2="12" y2="21"/><path d="M5 10c0-4 3-7 7-7s7 3 7 7"/><path d="M8 13c0-2 2-4 4-4s4 2 4 4"/></svg>';
    if (t === 'jb')       return '<svg ' + common + '><rect x="4" y="7" width="16" height="12" rx="2"/><path d="M8 12h8M12 9v6"/></svg>';
    if (t === 'rack')     return '<svg ' + common + '><rect x="6" y="3" width="12" height="18" rx="1.5"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="16" y2="11"/><line x1="8" y1="15" x2="16" y2="15"/></svg>';
    if (t === 'server')   return '<svg ' + common + '><rect x="3" y="6" width="18" height="5" rx="1"/><rect x="3" y="13" width="18" height="5" rx="1"/><circle cx="7" cy="8.5" r="1" fill="currentColor"/><circle cx="7" cy="15.5" r="1" fill="currentColor"/></svg>';
    if (t === 'switch')   return '<svg ' + common + '><rect x="3" y="8" width="18" height="8" rx="1.5"/><circle cx="7" cy="12" r="1" fill="currentColor"/><circle cx="11" cy="12" r="1" fill="currentColor"/><circle cx="15" cy="12" r="1" fill="currentColor"/></svg>';
    if (t === 'otb')      return '<svg ' + common + '><rect x="4" y="5" width="16" height="14" rx="2"/><circle cx="8" cy="12" r="1.4"/><circle cx="12" cy="12" r="1.4"/><circle cx="16" cy="12" r="1.4"/></svg>';
    return '<svg ' + common + '><circle cx="12" cy="12" r="9"/></svg>';
  }

  // Klik / pilih hasil → pan + zoom + open popup
  window._mapSearchPick = function(globalIdx) {
    const results = window._mapSearchCurrentResults;
    if (!results || !results._flatRef) return;
    const item = results._flatRef[globalIdx];
    if (!item) return;
    // Tutup dropdown DULU supaya tidak menutupi marker tujuan saat fly,
    // lalu blur input agar keyboard mobile sembunyi & user fokus ke peta.
    closeMapSearch();
    const inp = document.getElementById('mapSearchInput');
    if (inp) inp.blur();
    // Jeda 1 frame supaya UI sempat update sebelum mulai animasi
    requestAnimationFrame(() => navigateToMapPoint(item));
  };

  // Zoom level optimal per tipe — biar landing-nya selalu nyaman untuk lihat
  // detail titik tujuan. Customer & ODP perlu lebih zoom (titik kecil),
  // ODC/POP boleh sedikit lebih jauh karena biasanya area cakupannya luas.
  const ZOOM_BY_TYPE = {
    customer: 19,
    odp:      19,
    jb:       18,
    tower:    18,
    odc:      18,
    pop:      17,
    rack:     18,
    server:   18,
    switch:   18,
    otb:      18,
  };

  // Pan & zoom ke titik dengan animasi cinematic mirip Google Maps.
  // Strategi:
  //   1. flyTo dengan duration agak panjang (1.2s) supaya transisi halus
  //      tidak abrupt. Easing rendah (0.18) → gerakan terasa natural,
  //      bukan linear.
  //   2. Set zoom yang nyaman per tipe — bukan sekedar Math.max(zoom, X),
  //      tapi paksa ke level yang tepat untuk lihat detail. Kalau user
  //      sudah zoom lebih dalam dari target, hormati pilihannya.
  //   3. Setelah landing, render "highlight ring" pulse di marker tujuan
  //      selama beberapa detik agar mudah ditemukan secara visual.
  //   4. Buka popup setelah view settle (1300ms) — beri jeda 100ms ekstra
  //      dari durasi fly supaya popup tidak loncat-loncat saat animasi.
  let _searchHighlightRing = null;
  let _searchHighlightTimer = null;

  window.navigateToMapPoint = function(item) {
    // Akses 'map' sebagai bare identifier — top-level `let map` di
    // infrastructure.js ada di global scope tapi BUKAN window.map (let/const
    // tidak di-attach ke window seperti var). Inilah bug yang bikin klik
    // dari dropdown sebelumnya tidak ada respons.
    if (typeof map === 'undefined' || !map || !item) {
      console.warn('[search] map belum siap atau item kosong');
      return;
    }
    const ll = [item.lat, item.lng];

    const targetZoom  = ZOOM_BY_TYPE[item.type] || 18;
    const currentZoom = map.getZoom();
    const finalZoom = Math.max(targetZoom, Math.min(currentZoom, 20));

    map.flyTo(ll, finalZoom, {
      animate: true,
      duration: 1.2,
      easeLinearity: 0.18,
    });

    if (_searchHighlightRing) {
      try { map.removeLayer(_searchHighlightRing); } catch (_) {}
      _searchHighlightRing = null;
    }
    if (_searchHighlightTimer) {
      clearTimeout(_searchHighlightTimer);
      _searchHighlightTimer = null;
    }

    setTimeout(() => {
      const ringHtml = '<div class="search-target-ring"></div>'
                     + '<div class="search-target-ring delay"></div>';
      _searchHighlightRing = L.marker(ll, {
        icon: L.divIcon({
          html: ringHtml,
          className: 'search-target-icon-wrapper',
          iconSize: [80, 80],
          iconAnchor: [40, 40],
        }),
        interactive: false,
        zIndexOffset: -1000,
      }).addTo(map);

      let marker = null;
      if (item.ref === 'infra' && window.markersById) {
        marker = window.markersById[item.id];
      }
      if (!marker && item.ref === 'customer' && window.customerMarkersById) {
        marker = window.customerMarkersById[item.id];
      }
      if (marker && typeof marker.openPopup === 'function') {
        marker.openPopup();
      }

      _searchHighlightTimer = setTimeout(() => {
        if (_searchHighlightRing) {
          try { map.removeLayer(_searchHighlightRing); } catch (_) {}
          _searchHighlightRing = null;
        }
        _searchHighlightTimer = null;
      }, 4000);
    }, 1250);
  };

  // Tutup dropdown
  window.closeMapSearch = function() {
    const dd = document.getElementById('mapSearchDropdown');
    if (dd) dd.classList.remove('open');
    searchHighlightIdx = -1;
  };

  // Bersihkan input
  window.clearMapSearch = function() {
    const inp  = document.getElementById('mapSearchInput');
    const wrap = document.getElementById('mapSearchInputWrap');
    if (inp)  inp.value = '';
    if (wrap) wrap.classList.remove('has-value');
    closeMapSearch();
    inp && inp.focus();
  };

  // Public: tandai bahwa data peta sudah ter-load supaya search index siap
  // Dipanggil oleh loadInfraData() setelah selesai render.
  window.refreshMapSearchIndex = function() {
    buildSearchIndex();
  };

  // Init listener saat DOM ready
  document.addEventListener('DOMContentLoaded', function() {
    const inp  = document.getElementById('mapSearchInput');
    const wrap = document.getElementById('mapSearchInputWrap');
    const dd   = document.getElementById('mapSearchDropdown');
    if (!inp || !dd) return;

    // Debounce input
    let debounceTimer = null;
    inp.addEventListener('input', function() {
      const q = this.value;
      if (wrap) {
        if (q && q.length > 0) wrap.classList.add('has-value');
        else wrap.classList.remove('has-value');
      }
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        if (!q.trim()) { closeMapSearch(); return; }
        // Rebuild index kalau lebih dari 30 detik (data berubah)
        if (Date.now() - _searchIndexBuiltAt > 30000) buildSearchIndex();
        renderDropdown(filterSearch(q), q);
      }, 120);
    });

    inp.addEventListener('focus', function() {
      if (this.value.trim()) {
        if (Date.now() - _searchIndexBuiltAt > 30000) buildSearchIndex();
        renderDropdown(filterSearch(this.value), this.value);
      }
    });

    // Keyboard navigation
    inp.addEventListener('keydown', function(e) {
      const items = dd.querySelectorAll('.map-search-item');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        searchHighlightIdx = Math.min(searchHighlightIdx + 1, items.length - 1);
        updateHighlight(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        searchHighlightIdx = Math.max(searchHighlightIdx - 1, 0);
        updateHighlight(items);
      } else if (e.key === 'Enter') {
        if (searchHighlightIdx >= 0 && items[searchHighlightIdx]) {
          e.preventDefault();
          const idx = parseInt(items[searchHighlightIdx].getAttribute('data-idx'));
          window._mapSearchPick(idx);
        } else if (items.length > 0) {
          // Default: pilih hasil pertama
          e.preventDefault();
          const idx = parseInt(items[0].getAttribute('data-idx'));
          window._mapSearchPick(idx);
        }
      } else if (e.key === 'Escape') {
        closeMapSearch();
        this.blur();
      }
    });

    function updateHighlight(items) {
      items.forEach((el, i) => {
        el.classList.toggle('highlighted', i === searchHighlightIdx);
        if (i === searchHighlightIdx) el.scrollIntoView({ block: 'nearest' });
      });
    }

    // Tutup dropdown kalau klik di luar
    document.addEventListener('click', function(e) {
      const wrapEl = document.getElementById('mapSearchWrap');
      if (wrapEl && !wrapEl.contains(e.target)) closeMapSearch();
    });
  });
})();
</script>

<div class="core-panel" id="corePanel" aria-hidden="true">
  <div class="core-panel-hd">
    <h3>Manajemen Core Kabel</h3>
    <button class="modal-close" type="button" onclick="CoreMap.close()" aria-label="Tutup">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="core-tabs">
    <button class="core-tab on" type="button" data-tab="cables" onclick="CoreMap.tab('cables',this)">Kabel</button>
    <button class="core-tab" type="button" data-tab="map" onclick="CoreMap.tab('map',this)">Sambungan</button>
    <button class="core-tab" type="button" data-tab="trace" onclick="CoreMap.tab('trace',this)">Tracing</button>
  </div>
  <div class="core-body" id="coreBody">Memuat…</div>
</div>

