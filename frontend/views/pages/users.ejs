<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= title %> - <%= appName %></title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <style>
    .users-body{padding:0;}
    .users-table-wrap{
      overflow-x:auto;
      -webkit-overflow-scrolling:touch;
      overscroll-behavior-x:contain;
      max-width:100%;
    }
    .users-table{min-width:720px;}
    .users-table th,.users-table td{white-space:nowrap;}
    .users-table .users-aksi,
    .users-table td:last-child{
      position:sticky;right:0;background:#fff;z-index:2;
      box-shadow:-8px 0 12px -8px rgba(15,23,42,.18);
    }
    .users-table thead .users-aksi{background:#f8fafc;z-index:3;}
    .users-actions{display:flex;gap:6px;flex-wrap:nowrap;}
    .users-cards{display:none;flex-direction:column;gap:10px;padding:12px;}
    .ucard{border:1px solid #eef1f6;border-radius:14px;padding:14px 14px 12px;background:#fff;}
    .ucard-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;}
    .ucard-name{font-size:15px;font-weight:700;color:#0f172a;}
    .ucard-sub{font-size:12px;color:#94a3b8;margin-top:2px;}
    .ucard-email{font-size:13px;color:#334155;margin-top:8px;word-break:break-all;}
    .ucard-meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;align-items:center;}
    .ucard-login{font-size:12px;color:#64748b;margin-top:8px;}
    .ucard-act{display:flex;gap:8px;margin-top:12px;}
    .ucard-act .btn{flex:1;min-height:42px;}
    .btn-del{background:#dc2626;color:#fff;border:none;}
    .btn-del:hover{background:#b91c1c;}
    @media(max-width:768px){
      .page-header{flex-direction:column;align-items:stretch;gap:10px;}
      .page-header-right .btn{width:100%;}
      .users-table-wrap{display:none;}
      .users-cards{display:flex;}
      #userModal > div{max-width:none;width:calc(100vw - 24px);margin:12px;max-height:88vh;overflow:auto;}
    }
  </style>
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/topbar') %>
    <main class="page-content">

      <div class="page-header">
        <div class="page-header-left"><h1>User Management</h1></div>
        <div class="page-header-right">
          <button class="btn btn-primary" onclick="openAddUser()">+ Tambah User</button>
        </div>
      </div>

      <div class="card">
        <div class="card-body users-body">
          <div class="users-table-wrap">
            <table class="data-table users-table">
              <thead>
                <tr>
                  <th>Nama</th><th>Email</th><th>Role</th><th>Status</th><th>Last Login</th><th class="users-aksi">Aksi</th>
                </tr>
              </thead>
              <tbody id="userTable">
                <tr><td colspan="6" style="text-align:center;padding:40px;color:#94a3b8;">Memuat...</td></tr>
              </tbody>
            </table>
          </div>
          <div class="users-cards" id="userCards"></div>
        </div>
      </div>

    </main>
  </div>
</div>

<!-- Modal -->
<div id="userModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:1000;align-items:center;justify-content:center;">
  <div style="background:#fff;border-radius:12px;padding:28px;width:100%;max-width:460px;box-shadow:0 20px 60px rgba(0,0,0,0.15);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
      <h3 id="userModalTitle" style="font-size:16px;font-weight:600;margin:0;">Tambah User</h3>
      <button onclick="closeUserModal()" style="background:none;border:none;font-size:20px;cursor:pointer;color:#64748b;">x</button>
    </div>
    <form id="userForm" onsubmit="event.preventDefault();saveUser();">
      <div style="margin-bottom:14px;">
        <label style="display:block;font-size:13px;font-weight:500;margin-bottom:6px;">Nama *</label>
        <input id="userName" type="text" placeholder="Nama lengkap" required style="width:100%;padding:8px 12px;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;box-sizing:border-box;">
      </div>
      <div style="margin-bottom:14px;">
        <label style="display:block;font-size:13px;font-weight:500;margin-bottom:6px;">Email *</label>
        <input id="userEmail" type="email" placeholder="email@domain.com" required style="width:100%;padding:8px 12px;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;box-sizing:border-box;">
      </div>
      <div style="margin-bottom:14px;">
        <label style="display:block;font-size:13px;font-weight:500;margin-bottom:6px;">No. HP</label>
        <input id="userPhone" type="text" placeholder="08xxxxxxxxxx" style="width:100%;padding:8px 12px;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;box-sizing:border-box;">
      </div>
      <div id="passwordGroup" style="margin-bottom:14px;">
        <label style="display:block;font-size:13px;font-weight:500;margin-bottom:6px;">Password *</label>
        <input id="passwordField" type="password" placeholder="Minimal 6 karakter" style="width:100%;padding:8px 12px;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;box-sizing:border-box;">
      </div>
      <div style="margin-bottom:20px;">
        <label style="display:block;font-size:13px;font-weight:500;margin-bottom:6px;">Role *</label>
        <select id="userRole" required style="width:100%;padding:8px 12px;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;box-sizing:border-box;">
          <option value="">-- Pilih Role --</option>
        </select>
      </div>
      <div style="display:flex;gap:10px;justify-content:flex-end;">
        <button type="button" onclick="closeUserModal()" class="btn btn-secondary">Batal</button>
        <button type="submit" class="btn btn-primary">Simpan</button>
      </div>
    </form>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/socket.io-client@4.7.2/dist/socket.io.min.js"></script>
<script src="/js/app.js"></script>
<script>
  window.ME_USER_ID = <%- Number(user && user.id) || 0 %>;
</script>
<script src="/js/users.js?v=20260922"></script>
</body>
</html>
